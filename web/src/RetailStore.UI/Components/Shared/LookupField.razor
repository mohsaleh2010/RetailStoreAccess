@typeparam T
@inject UiLanguage L

@* Choose a product, customer, supplier or account by its code or name; its balance or price beside the name.
   Either Items (searched here: LookupMatch) or SearchFunc (a search of the service).
   Example: <LookupField T="Customer" Label="@L.T("العميل")" Items="customers" @bind-Value="customer"
                         CodeOf="c => c.CustomerCode" NameOf="c => c.CustomerName">
                <InfoTemplate Context="c"><MoneyText Value="c.Balance" /></InfoTemplate></LookupField> *@
<MudAutocomplete T="T" Value="Value" ValueChanged="Changed" Label="@Label" Placeholder="@Placeholder" HelperText="@HelperText"
                 SearchFunc="Find" ToStringFunc="Display" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                 Clearable="!Required" ResetValueOnEmptyText="true" CoerceText="false" SelectValueOnTab="true" MaxItems="MaxItems"
                 Required="Required" RequiredError="@L.T("مطلوب")" Disabled="Disabled" ReadOnly="ReadOnly" DebounceInterval="200"
                 AdornmentIcon="@Icons.Material.Outlined.Search" Adornment="Adornment.Start" Immediate="true" AutoFocus="AutoFocus"
                 Class="@("erp-lookup " + Class)" ShowProgressIndicator="SearchFunc is not null">
    <ItemTemplate Context="item">
        <div class="erp-lookup-item">
            @if (CodeOf is not null)
            {
                <span class="erp-lookup-code erp-num">@CodeOf(item)</span>
            }
            <span class="erp-lookup-name">@NameOf(item)</span>
            @if (InfoTemplate is not null)
            {
                <span class="erp-lookup-info">@InfoTemplate(item)</span>
            }
        </div>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.body2" Class="px-4 py-2 mud-text-secondary">@L.T("لا توجد نتائج")</MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public IEnumerable<T>? Items { get; set; }
    /// <summary>The search of a service, for long lists (Items is then ignored).</summary>
    [Parameter] public Func<string?, CancellationToken, Task<IEnumerable<T>>>? SearchFunc { get; set; }
    [Parameter] public Func<T, string?>? CodeOf { get; set; }
    [Parameter, EditorRequired] public Func<T, string?> NameOf { get; set; } = default!;
    /// <summary>The balance or price shown beside the name in the list.</summary>
    [Parameter] public RenderFragment<T>? InfoTemplate { get; set; }
    [Parameter] public int MaxItems { get; set; } = 20;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public string? Class { get; set; }

    private string Display(T? item)
    {
        if (item is null)
        {
            return "";
        }
        string code = CodeOf?.Invoke(item) ?? "";
        string name = NameOf(item) ?? "";
        return code.Length == 0 ? name : code + " - " + name;
    }

    private Task<IEnumerable<T>> Find(string? text, CancellationToken cancel)
    {
        if (SearchFunc is not null)
        {
            return SearchFunc(text, cancel);
        }
        // the text of the chosen item ("code - name") lists everything again, as an empty box does
        if (Value is not null && text == Display(Value))
        {
            text = "";
        }
        return Task.FromResult(LookupMatch.Filter(Items ?? [], text, CodeOf, NameOf, MaxItems));
    }

    private Task Changed(T? item) => ValueChanged.InvokeAsync(item);
}
