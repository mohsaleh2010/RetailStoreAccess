@typeparam T where T : class, new()
@inject DataScreenService Service
@inject PermissionService Permissions
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject UiLanguage L

@* Template A of the redesign (docs/ui-inventory.md section 8): every data screen of the web (products, customers,
   suppliers, warehouses) = PageHeader with "new" -> EntityGrid of the list columns of the spec with edit / delete
   icons -> add and edit in DataScreenDialog (EntityDialog). The list, search, rules, messages and their order stay
   those of DataScreenService (modForms). *@
<PageHeader Title="@L.T(Spec.Caption)" Description="@L.T(Spec.Subtitle)" Icon="@NavGroups.IconOf(Spec.Route)"
            Group="@Group">
    <Actions>
        @if (allowed)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="NewRecord"
                       Disabled="busy">@L.T("إضافة جديد")<kbd class="erp-kbd">F4</kbd></MudButton>
        }
    </Actions>
</PageHeader>

@if (!allowed)
{
    @if (loaded)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@L.T(denied)</MudAlert>
    }
}
else
{
    <KeyboardShortcuts OnNew="NewRecord" />
    <EntityGrid T="ListRow" Items="rows" SearchChanged="SearchChanged" SearchPlaceholder="@L.T("بحث بالكود أو الاسم")"
                Export="export" ExportName="@L.T(Spec.Caption)" Loading="loading" RowClick="r => Open(r.Key)"
                RowClass="@((r, _) => r.Active ? "" : "erp-row-inactive")" EmptyText="@L.T("اضغط إضافة جديد لإضافة أول سجل")">
        <ToolBarContent>
            @if (Spec.ActiveField is not null)
            {
                <MudSwitch T="bool" Value="showInactive" ValueChanged="InactiveChanged" Color="Color.Primary" Class="erp-grid-switch"
                           Label="@L.T("إظهار غير النشط")" />
            }
        </ToolBarContent>
        <Columns>
            @for (int i = 0; i < Spec.Columns.Length; i++)
            {
                int col = i;
                var c = Spec.Columns[col];
                bool number = IsNumber(c);
                <TemplateColumn T="ListRow" Title="@L.T(c.Header)" SortBy="r => SortKey(r, col, number)"
                                HeaderClass="@(number ? "erp-num" : "")" CellClass="@(number ? "erp-num" : "")">
                    <CellTemplate>
                        @if (col == 0 && !context.Item.Active)
                        {
                            <span class="erp-cell-inactive">@context.Item.Cells[col]</span>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="erp-chip-inactive">@L.T("غير نشط")</MudChip>
                        }
                        else if (number)
                        {
                            <bdi dir="ltr" class="@(context.Item.Cells[col].StartsWith('-') ? "erp-negative" : "")">@context.Item.Cells[col]</bdi>
                        }
                        else
                        {
                            @context.Item.Cells[col]
                        }
                    </CellTemplate>
                </TemplateColumn>
            }
            <TemplateColumn T="ListRow" Title="@L.T("إجراءات")" Sortable="false" Filterable="false" HeaderClass="erp-actions-col"
                            CellClass="erp-actions-col">
                <CellTemplate>
                    <MudTooltip Text="@L.T("تعديل")">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="() => Open(context.Item.Key)" aria-label="@L.T("تعديل")" />
                    </MudTooltip>
                    <MudTooltip Text="@L.T("حذف")">
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => AskDelete(context.Item)" aria-label="@L.T("حذف")" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </EntityGrid>
    @if (rows.Count >= DataScreenService.MaxListRows)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@L.T("ضيّق البحث لعرض باقي السجلات")</MudText>
    }
}

@code {
    [Parameter, EditorRequired] public ScreenSpec<T> Spec { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ClaimsPrincipal? user;
    private bool allowed, loaded, loading, busy;
    private string denied = "";
    private List<ListRow> rows = [];
    private string search = "";
    private bool showInactive;
    private readonly Dictionary<string, List<LookupItem>> lookups = [];
    private List<GridExport<ListRow>> export = [];

    private string? Group => NavGroups.GroupOf(Spec.Route) is { Length: > 0 } g ? L.T(g) : null;

    protected override async Task OnInitializedAsync()
    {
        user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(UserInfo.EmployeeId(user), Spec.Name);
        allowed = denied.Length == 0;
        loaded = true;
        if (!allowed)
        {
            return;
        }
        export = Spec.Columns.Select((c, i) => new GridExport<ListRow>(L.T(c.Header), r => r.Cells[i])).ToList();
        foreach (var f in Spec.Fields.Where(f => f.Lookup is not null))
        {
            lookups[f.Name] = await Service.LookupAsync(f.Lookup!, L.English);
        }
        await Refresh();
    }

    /// <summary>A column of numbers (quantity, price, balance ...) is aligned as numbers and sorted by value.</summary>
    private bool IsNumber(ColumnSpec c) =>
        Spec.Field(c.Field)?.Kind is FieldKind.Money or FieldKind.Quantity or FieldKind.Rate or FieldKind.Integer;

    private static object SortKey(ListRow r, int col, bool number) =>
        number && decimal.TryParse(r.Cells[col].Replace(",", ""), System.Globalization.NumberStyles.Number,
                                   System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : r.Cells[col];

    private async Task Refresh()
    {
        loading = true;
        try
        {
            rows = await Service.ListAsync(Spec, search, showInactive, L.English);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchChanged(string text)
    {
        search = text;
        await Refresh();
    }

    private async Task InactiveChanged(bool value)
    {
        showInactive = value;
        await Refresh();
    }

    private async Task NewRecord()
    {
        if (busy)
        {
            return;
        }
        var record = await Service.NewAsync(Spec);
        await EditAsync(record, true, new RecordState(new HashSet<string>()), L.T("إضافة") + " - " + L.T(Spec.Caption));
    }

    private async Task Open(int key)
    {
        if (busy)
        {
            return;
        }
        var record = await Service.LoadAsync(Spec, key);
        if (record is null)
        {
            await Refresh();
            return;
        }
        var state = await Service.StateAsync(Spec, record, false);
        await EditAsync(record, false, state, L.T("تعديل") + " - " + L.T(Spec.Caption));
    }

    private async Task EditAsync(T record, bool isNew, RecordState state, string title)
    {
        busy = true;
        try
        {
            SaveResult? saved = null;
            var parameters = new DialogParameters<DataScreenDialog<T>>
            {
                { x => x.Spec, Spec },
                { x => x.Record, record },
                { x => x.IsNew, isNew },
                { x => x.State, state },
                { x => x.Lookups, lookups },
                { x => x.User, user },
                { x => x.Title, title },
                { x => x.OnSaved, r => saved = r },
            };
            var dialog = await Dialogs.ShowAsync<DataScreenDialog<T>>(title, parameters, EntityDialog.WideOptions);
            await dialog.Result;
            if (saved is not null)
            {
                await Refresh();
                Snackbar.Add(L.T(saved.Message), Severity.Success);
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AskDelete(ListRow row)
    {
        string name = row.Cells.Length > 1 ? row.Cells[0] + " - " + row.Cells[1] : row.Cells.FirstOrDefault() ?? "";
        if (await ConfirmDialog.AskAsync(Dialogs, L.T("حذف"), L.T("هل تريد حذف هذا السجل نهائيًا؟") + " " + name, L.T("حذف")))
        {
            await Delete(row.Key, false);
        }
    }

    /// <summary>DataScreenService.DeleteAsync: a record that has transactions is offered deactivation (its question).</summary>
    private async Task Delete(int key, bool deactivate)
    {
        var r = await Service.DeleteAsync(Spec, key, UserInfo.Acting(user), deactivate);
        switch (r.Status)
        {
            case SaveStatus.Refused:
                Snackbar.Add(L.T(r.Message), Severity.Error);
                break;
            case SaveStatus.NeedsConfirmation:
                if (await ConfirmDialog.AskAsync(Dialogs, L.T("إيقاف السجل"), L.T(r.Message), L.T("نعم"), Color.Warning))
                {
                    await Delete(key, true);
                }
                break;
            case SaveStatus.Saved:
                await Refresh();
                Snackbar.Add(L.T(r.Message), deactivate ? Severity.Warning : Severity.Success);
                break;
        }
    }
}
