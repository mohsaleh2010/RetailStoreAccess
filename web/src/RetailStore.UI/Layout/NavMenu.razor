@inject UiLanguage L

@* The side menu: the home page, then one group per module (Layout/NavGroups.cs) with the screens the user may open. *@
<MudNavMenu Color="Color.Primary" Bordered="true" Dense="true" Class="erp-nav py-2">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">@L.T("الرئيسية")</MudNavLink>
    @foreach (var g in Groups)
    {
        <MudNavGroup Title="@L.T(g.Caption)" Icon="@g.Icon" Expanded="true">
            @foreach (var item in g.Items)
            {
                <MudNavLink Href="@item.Route" Match="NavLinkMatch.Prefix" Icon="@item.Icon">@L.T(item.Caption)</MudNavLink>
            }
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    /// <summary>The groups of the signed-in user (NavGroups.ForUserAsync, computed once by MainLayout).</summary>
    [Parameter] public IReadOnlyList<NavGroup> Groups { get; set; } = [];
}
