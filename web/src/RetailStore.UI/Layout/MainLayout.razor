@inherits LayoutComponentBase
@inject UiLanguage L
@inject UiTheme Mode
@inject NavigationManager Nav
@inject PermissionService Permissions
@inject IJSRuntime JS

@* The frame of every interactive page: the direction follows the language (Arabic rtl / English ltr), the light or dark
   mode the "theme" cookie, the menu the permissions of the user. *@
<MudRTLProvider RightToLeft="@(L.Dir == "rtl")">
    <MudThemeProvider Theme="ErpTheme.Theme" IsDarkMode="@Mode.Dark" />
    <MudPopoverProvider />
    <MudDialogProvider CloseOnEscapeKey="true" />
    <MudSnackbarProvider />

    <MudLayout Class="erp-app">
        <MudAppBar Elevation="0" Dense="true" Class="erp-appbar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="ToggleDrawer" aria-label="@L.T("القائمة")" />
            <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Class="erp-brand">
                <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" />
                <span class="erp-brand-name">@storeName</span>
            </MudLink>
            <MudSpacer />
            <AuthorizeView>
                <Authorized>
                    <MudAutocomplete T="NavItem" Value="found" SearchFunc="FindScreen" ToStringFunc="@(i => i is null ? "" : L.T(i.Caption))"
                                     Placeholder="@L.T("بحث عن شاشة")" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     AdornmentIcon="@Icons.Material.Outlined.Search" Adornment="Adornment.Start" Clearable="true"
                                     ResetValueOnEmptyText="true" CoerceText="false" MaxItems="12" Class="erp-screen-search"
                                     ValueChanged="OpenScreen" aria-label="@L.T("بحث عن شاشة")">
                        <ItemTemplate Context="item">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@L.T(item.Caption)</MudText>
                            </MudStack>
                        </ItemTemplate>
                    </MudAutocomplete>
                </Authorized>
            </AuthorizeView>
            <MudTooltip Text="@(Mode.Dark ? L.T("الوضع الفاتح") : L.T("الوضع الليلي"))">
                <MudIconButton Icon="@(Mode.Dark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               Color="Color.Inherit" OnClick="ToggleDark"
                               aria-label="@(Mode.Dark ? L.T("الوضع الفاتح") : L.T("الوضع الليلي"))" />
            </MudTooltip>
            <MudTooltip Text="@(L.English ? "العربية" : "English")">
                <MudIconButton Icon="@Icons.Material.Outlined.Translate" Color="Color.Inherit" OnClick="SwitchLanguage"
                               aria-label="@(L.English ? "العربية" : "English")" />
            </MudTooltip>
            <AuthorizeView>
                <Authorized Context="auth">
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true"
                             aria-label="@L.T("المستخدم")">
                        <ActivatorContent>
                            <MudChip T="string" Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Default"
                                     Variant="Variant.Text" Class="erp-user-chip">@auth.User.Identity?.Name</MudChip>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Password" OnClick="ChangePassword">@L.T("تغيير كلمة المرور")</MudMenuItem>
                            <MudDivider />
                            <form method="post" action="account/logout" class="erp-logout">
                                <AntiforgeryToken />
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Error" FullWidth="true"
                                           StartIcon="@Icons.Material.Outlined.Logout" Class="justify-start px-4">@L.T("تسجيل الخروج")</MudButton>
                            </form>
                        </ChildContent>
                    </MudMenu>
                </Authorized>
            </AuthorizeView>
        </MudAppBar>

        <MudDrawer @bind-Open="drawerOpen" Variant="DrawerVariant.Responsive" Anchor="Anchor.Start" ClipMode="DrawerClipMode.Always"
                   Elevation="0" Class="erp-drawer">
            <NavMenu Groups="groups" />
        </MudDrawer>

        <MudMainContent Class="erp-main">
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4">
                <MustChangePasswordGuard />
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    @L.T("حدث خطأ غير متوقع.")
    <a href="." class="reload">@L.T("إعادة التحميل")</a>
</div>

@code {
    [Inject] private IStoreInfo Store { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string storeName = "";
    private bool drawerOpen = true;
    private List<NavGroup> groups = [];
    private NavItem? found;

    private string LanguageLink =>
        "lang/" + (L.English ? "ar" : "en") + "?returnUrl=" + Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri));

    protected override async Task OnInitializedAsync()
    {
        storeName = await Store.StoreNameAsync(L.English);
        var user = AuthState is null ? null : (await AuthState).User;
        groups = await NavGroups.ForUserAsync(Permissions, UserInfo.EmployeeId(user));
    }

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    private async Task ToggleDark()
    {
        Mode.Set(!Mode.Dark);
        await JS.InvokeVoidAsync("erp.setTheme", Mode.CookieValue);
    }

    private void SwitchLanguage() => Nav.NavigateTo(LanguageLink, forceLoad: true);

    private void ChangePassword() => Nav.NavigateTo("account/change-password", forceLoad: true);

    /// <summary>The quick search of the app bar: the screens of the menu whose caption (in the interface language) holds
    /// the typed text.</summary>
    private Task<IEnumerable<NavItem>> FindScreen(string? text, CancellationToken cancel)
    {
        var items = groups.SelectMany(g => g.Items);
        if (!string.IsNullOrWhiteSpace(text))
        {
            string t = text.Trim();
            items = items.Where(i => L.T(i.Caption).Contains(t, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(items);
    }

    private void OpenScreen(NavItem? item)
    {
        found = null;
        if (item is not null)
        {
            Nav.NavigateTo(item.Route);
        }
    }
}
