@inject NavigationManager Nav

@code {
    // modSecurity: a user with a temporary password (or the administrator without one) changes it before working.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        if (UserInfo.MustChangePassword(user))
        {
            Nav.NavigateTo("account/change-password", forceLoad: true);
        }
    }
}
