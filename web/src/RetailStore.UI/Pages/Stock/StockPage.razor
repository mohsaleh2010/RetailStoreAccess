@page "/stock"
@attribute [Authorize]
@inject StockService Stock
@inject PermissionService Permissions
@inject IJSRuntime JS
@inject UiLanguage L

@* Template C (docs/ui-inventory.md section 8) for the stock and the item card: PageHeader (print) -> FilterPanel (the
   warehouse, the search the service looks in, the items under the reorder level) -> the figures of the rows shown ->
   EntityGrid of the stock (a row opens its card) -> the item card of the chosen product: its period, then EntityGrid of
   its moves (the opening line first). The data is StockService.StockAsync / ItemCardAsync with the permission of
   frmInventory. *@
<PageHeader Title="@L.T("المخزون")" Description="@L.T("رصيد كل صنف في كل مخزن، وكارت الصنف")"
            Icon="@NavGroups.IconOf("stock")" Group="@L.T("المخازن")">
    <Actions>
        @if (allowed)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Print" OnClick="Print">
                @L.T("طباعة")<kbd class="erp-kbd">Ctrl+P</kbd>
            </MudButton>
        }
    </Actions>
</PageHeader>

@if (!allowed)
{
    @if (loaded)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@L.T(denied)</MudAlert>
    }
}
else
{
    <KeyboardShortcuts OnPrint="Print" />
    <FilterPanel ShowDates="false" OnShow="Load" OnClear="Reset" Busy="busy" Class="no-print">
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int" Value="warehouseId" ValueChanged="WarehouseChanged" Label="@L.T("المخزن")" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Dense="true">
                <MudSelectItem T="int" Value="0">@L.T("كل المخازن")</MudSelectItem>
                @foreach (var w in warehouses)
                {
                    <MudSelectItem T="int" Value="@w.Id">@w.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string" @bind-Value="search" Label="@L.T("بحث")" Placeholder="@L.T("ابحث عن صنف أو اكتب الباركود")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" AutoFocus="true" Immediate="true"
                          OnKeyDown="SearchKey" data-erp-search="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
            <MudSwitch T="bool" Value="lowOnly" ValueChanged="LowChanged" Color="Color.Warning" Label="@L.T("الأصناف تحت حد الطلب")" />
        </MudItem>
    </FilterPanel>

    <MudText Typo="Typo.subtitle1" Class="mb-3 erp-print-title">
        @L.T("المخزون") - @WarehouseName
    </MudText>
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Title="@L.T("عدد الأصناف")" Value="@rows.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      Icon="@Icons.Material.Outlined.Inventory2" Color="Color.Info" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Title="@L.T("قيمة المخزون")" Icon="@Icons.Material.Outlined.Savings" Color="Color.Primary">
                <ValueContent><MoneyText Value="rows.Sum(r => r.Value)" /></ValueContent>
            </StatCard>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Title="@L.T("الأصناف تحت حد الطلب")" Value="@rows.Count(r => r.IsLow).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      Icon="@Icons.Material.Outlined.ReportProblem" Color="Color.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Title="@L.T("الكمية")" Icon="@Icons.Material.Outlined.Numbers" Color="Color.Secondary"
                      Subtitle="@(warehouseId > 0 ? L.T("محجوز") + ": " + ErpFormat.Qty(rows.Sum(r => r.Reserved)) : null)">
                <ValueContent><QtyText Value="rows.Sum(r => r.Quantity)" /></ValueContent>
            </StatCard>
        </MudItem>
    </MudGrid>

    <EntityGrid T="StockRow" Items="rows" Title="@L.T("رصيد المخزون")" Export="export" ExportName="@L.T("المخزون")"
                Loading="busy" Filterable="false" RowsPerPage="50" RowClick="Card" RowClass="StockRowClass" Class="mb-4"
                EmptyText="@L.T("لا توجد سجلات")">
        <Columns>
            <PropertyColumn T="StockRow" TProperty="string" Property="r => r.ProductCode" Title="@L.T("الرمز")" />
            <PropertyColumn T="StockRow" TProperty="string" Property="r => r.ProductName" Title="@L.T("الصنف")" />
            <PropertyColumn T="StockRow" TProperty="string" Property="r => r.UnitName" Title="@L.T("الوحدة")" />
            <TemplateColumn T="StockRow" Title="@L.T("الكمية")" SortBy="r => r.Quantity" HeaderClass="erp-num" CellClass="erp-num">
                <CellTemplate><QtyText Value="context.Item.Quantity" /></CellTemplate>
            </TemplateColumn>
            @if (warehouseId > 0)
            {
                <TemplateColumn T="StockRow" Title="@L.T("محجوز")" SortBy="r => r.Reserved" HeaderClass="erp-num" CellClass="erp-num">
                    <CellTemplate><QtyText Value="context.Item.Reserved" /></CellTemplate>
                </TemplateColumn>
            }
            <TemplateColumn T="StockRow" Title="@L.T("الحد الأدنى")" SortBy="r => r.MinimumQuantity" HeaderClass="erp-num" CellClass="erp-num">
                <CellTemplate>
                    <QtyText Value="context.Item.MinimumQuantity" />
                    @if (context.Item.IsLow)
                    {
                        <MudTooltip Text="@L.T("الأصناف تحت حد الطلب")">
                            <MudIcon Icon="@Icons.Material.Outlined.ReportProblem" Color="Color.Warning" Size="Size.Small" Class="erp-low-icon" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="StockRow" Title="@L.T("متوسط التكلفة")" SortBy="r => r.AverageCost" HeaderClass="erp-num" CellClass="erp-num">
                <CellTemplate><MoneyText Value="context.Item.AverageCost" Decimals="4" /></CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="StockRow" Title="@L.T("القيمة")" SortBy="r => r.Value" HeaderClass="erp-num" CellClass="erp-num">
                <CellTemplate><MoneyText Value="context.Item.Value" /></CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="StockRow" Title="" Sortable="false" CellClass="erp-actions-col no-print" HeaderClass="erp-actions-col no-print">
                <CellTemplate>
                    <MudTooltip Text="@L.T("كارت الصنف")">
                        <MudIconButton Icon="@Icons.Material.Outlined.ManageSearch" Size="Size.Small" OnClick="() => Card(context.Item)"
                                       aria-label="@L.T("كارت الصنف")" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </EntityGrid>

    <div id="item-card">
        @if (productId == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.ManageSearch" Title="@L.T("كارت الصنف")"
                        Text="@L.T("اختر صنفًا من القائمة لعرض حركته")" Class="no-print" />
        }
        else
        {
            <FilterPanel Range="range" RangeChanged="r => range = r ?? ThisMonth()" OnShow="LoadCard" OnClear="ResetCard" Busy="cardBusy"
                         Title="@(L.T("كارت الصنف") + " - " + productName)" Class="no-print" />
            <MudText Typo="Typo.subtitle1" Class="mb-3 erp-print-title">
                @L.T("كارت الصنف") - @productName
                <span class="mud-text-secondary erp-num" dir="ltr">(@ErpFormat.Date(range.Start) - @ErpFormat.Date(range.End))</span>
            </MudText>
            <EntityGrid T="ItemCardLine" Items="card" Title="@L.T("حركة الصنف")" Export="cardExport"
                        ExportName="@(L.T("كارت الصنف") + " " + productName)" Loading="cardBusy" Filterable="false" RowsPerPage="50"
                        RowClass="CardRowClass" EmptyText="@L.T("لا توجد سجلات")">
                <Columns>
                    <TemplateColumn T="ItemCardLine" Title="@L.T("التاريخ")" SortBy="c => c.MovementDate">
                        <CellTemplate><bdi class="erp-num erp-nowrap" dir="ltr">@CardDate(context.Item)</bdi></CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ItemCardLine" Title="@L.T("الحركة")" SortBy="c => c.MovementType">
                        <CellTemplate>@L.T(context.Item.MovementType)</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn T="ItemCardLine" TProperty="string" Property="c => c.ReferenceNumber" Title="@L.T("المرجع")" />
                    <TemplateColumn T="ItemCardLine" Title="@L.T("الجهة")" SortBy="c => c.PartyName">
                        <CellTemplate>
                            @context.Item.PartyName
                            @if (warehouseId == 0 && context.Item.WarehouseName is { } wn)
                            {
                                <span class="mud-text-secondary erp-card-warehouse">(@wn)</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ItemCardLine" Title="@L.T("وارد")" SortBy="c => c.QtyIn" HeaderClass="erp-num" CellClass="erp-num">
                        <CellTemplate>
                            @if (context.Item.QtyIn != 0)
                            {
                                <QtyText Value="context.Item.QtyIn" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ItemCardLine" Title="@L.T("صادر")" SortBy="c => c.QtyOut" HeaderClass="erp-num" CellClass="erp-num">
                        <CellTemplate>
                            @if (context.Item.QtyOut != 0)
                            {
                                <QtyText Value="context.Item.QtyOut" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ItemCardLine" Title="@L.T("الرصيد")" SortBy="c => c.Balance" HeaderClass="erp-num" CellClass="erp-num">
                        <CellTemplate><QtyText Value="context.Item.Balance" /></CellTemplate>
                    </TemplateColumn>
                </Columns>
            </EntityGrid>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool allowed, loaded, busy, cardBusy, lowOnly;
    private string denied = "", productName = "";
    private string? search;
    private int warehouseId, productId;
    private DateRange range = ThisMonth();
    private List<StockRow> rows = [];
    private List<ItemCardLine> card = [];
    private List<(int Id, string Name)> warehouses = [];
    private List<GridExport<StockRow>> export = [];
    private List<GridExport<ItemCardLine>> cardExport = [];

    /// <summary>The period the card opened on, as before: the first of this month to today.</summary>
    private static DateRange ThisMonth() => new(DateTime.Today.AddDays(1 - DateTime.Today.Day), DateTime.Today);

    private string WarehouseName => warehouseId == 0
        ? L.T("كل المخازن")
        : warehouses.FirstOrDefault(w => w.Id == warehouseId).Name ?? "";

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(UserInfo.EmployeeId(user), "frmInventory");
        allowed = denied.Length == 0;
        loaded = true;
        if (allowed)
        {
            export =
            [
                new(L.T("الرمز"), r => r.ProductCode),
                new(L.T("الصنف"), r => r.ProductName),
                new(L.T("الوحدة"), r => r.UnitName),
                new(L.T("الكمية"), r => r.Quantity),
                new(L.T("محجوز"), r => r.Reserved),
                new(L.T("الحد الأدنى"), r => r.MinimumQuantity),
                new(L.T("متوسط التكلفة"), r => r.AverageCost),
                new(L.T("القيمة"), r => r.Value),
            ];
            cardExport =
            [
                new(L.T("التاريخ"), c => CardDate(c)),
                new(L.T("الحركة"), c => L.T(c.MovementType)),
                new(L.T("المرجع"), c => c.ReferenceNumber),
                new(L.T("الجهة"), c => c.PartyName),
                new(L.T("المخزن"), c => c.WarehouseName),
                new(L.T("وارد"), c => c.QtyIn),
                new(L.T("صادر"), c => c.QtyOut),
                new(L.T("الرصيد"), c => c.Balance),
            ];
            (warehouses, _) = await Stock.WarehousesAsync(UserInfo.EmployeeId(user), L.English);
            await Load();
        }
    }

    private async Task Load()
    {
        busy = true;
        try
        {
            rows = await Stock.StockAsync(warehouseId, search, lowOnly, L.English);
            if (productId > 0)
            {
                await LoadCard();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Reset()
    {
        warehouseId = 0;
        search = null;
        lowOnly = false;
        await Load();
    }

    private async Task WarehouseChanged(int id)
    {
        warehouseId = id;
        await Load();
    }

    private async Task LowChanged(bool value)
    {
        lowOnly = value;
        await Load();
    }

    private async Task SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Load();
        }
    }

    private string StockRowClass(StockRow r, int _) =>
        (r.IsLow ? "erp-row-low " : "") + (r.ProductID == productId ? "erp-row-selected" : "");

    private static string CardRowClass(ItemCardLine c, int _) => c.MoveID == 0 ? "erp-row-opening" : "";

    private async Task Card(StockRow r)
    {
        productId = r.ProductID;
        productName = r.ProductName;
        await LoadCard();
        StateHasChanged();
        await JS.InvokeVoidAsync("erp.scrollToId", "item-card");
    }

    private async Task LoadCard()
    {
        cardBusy = true;
        try
        {
            card = await Stock.ItemCardAsync(productId, warehouseId, range.Start ?? DateTime.Today, range.End ?? DateTime.Today, L.English);
        }
        finally
        {
            cardBusy = false;
        }
    }

    private async Task ResetCard()
    {
        range = ThisMonth();
        await LoadCard();
    }

    private static string CardDate(ItemCardLine c) =>
        c.MovementDate.ToString(c.MoveID == 0 ? "yyyy-MM-dd" : "yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private async Task Print() => await JS.InvokeVoidAsync("print");
}
