@page "/payments"
@attribute [Authorize]
@inject SalesService Sales
@inject PermissionService Permissions
@inject IDialogService Dialogs
@inject UiLanguage L

@* Template B for a voucher (docs/ui-inventory.md section 8): PageHeader (new F4, save F2) -> the voucher shown above the
   list (customer with his balance, amount, method, notes) with its card beside it -> FilterPanel (the period, the search
   of the service) -> EntityGrid of the vouchers. Posting is SalesService.PostPaymentAsync (modSales.PostCustomerPayment):
   its question goes through ConfirmDialog and the voucher is saved again with the answer. *@
<PageHeader Title="@L.T("سندات القبض")" Description="@L.T("تحصيل من العملاء نقدًا أو بالبطاقة أو التحويل")"
            Icon="@NavGroups.IconOf("payments")" Group="@L.T("المبيعات")">
    <Status>
        @if (allowed)
        {
            <StatusChip Status="DRAFT" />
        }
    </Status>
    <Actions>
        @if (allowed)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.NoteAdd" OnClick="New" Disabled="busy">
                @L.T("سند قبض جديد")<kbd class="erp-kbd">F4</kbd>
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save"
                       OnClick="() => Save(false)" Disabled="busy">
                @L.T("حفظ السند")<kbd class="erp-kbd">F2</kbd>
            </MudButton>
        }
    </Actions>
</PageHeader>

@if (!allowed)
{
    @if (loaded)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@L.T(denied)</MudAlert>
    }
}
else
{
    <KeyboardShortcuts OnSave="() => Save(false)" OnNew="New" />
    @if (message.Length > 0)
    {
        <MudAlert Severity="@severity" Variant="Variant.Outlined" Class="mb-4" role="status" ShowCloseIcon="true"
                  CloseIconClicked="() => message = string.Empty">@L.T(message)</MudAlert>
    }
    <div class="erp-doc mb-4">
        <div class="erp-doc-main">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L.T("سند قبض جديد")</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <LookupField @ref="customerField" T="CustomerChoice" Label="@L.T("العميل")" Items="customers" Value="Customer"
                                     ValueChanged="c => customerId = c?.Id ?? 0" NameOf="c => c.Name" Required="true" AutoFocus="true"
                                     HelperText="@(Customer is { } c ? L.T("الرصيد") + ": " + ErpFormat.Money(c.Balance) : "")">
                            <InfoTemplate Context="c"><MoneyText Value="c.Balance" /></InfoTemplate>
                        </LookupField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudNumericField T="decimal" @bind-Value="amount" Label="@L.T("المبلغ")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         HideSpinButtons="true" Min="0" Format="0.00" Class="erp-cell-num" Required="true"
                                         RequiredError="@L.T("مطلوب")" Culture="System.Globalization.CultureInfo.InvariantCulture" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" @bind-Value="methodId" Label="@L.T("طريقة الدفع")" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Dense="true">
                            @foreach (var m in methods)
                            {
                                <MudSelectItem T="int" Value="@m.Id">@m.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="notes" Label="@L.T("ملاحظات")" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" MaxLength="255" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </div>

        <aside class="erp-doc-side">
            <MudPaper Outlined="true" Class="pa-4 erp-summary">
                <MudText Typo="Typo.h6" Class="mb-3">@L.T("ملخص السند")</MudText>
                <dl class="erp-summary-list">
                    <dt>@L.T("رصيد العميل")</dt><dd><MoneyText Value="Customer?.Balance" /></dd>
                    <dt class="erp-summary-grand">@L.T("المبلغ")</dt>
                    <dd class="erp-summary-grand"><MoneyText Value="amount" ShowCurrency="true" Bold="true" /></dd>
                </dl>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-3"
                           StartIcon="@Icons.Material.Outlined.Save" OnClick="() => Save(false)" Disabled="busy">
                    @L.T("حفظ السند")
                </MudButton>
            </MudPaper>
        </aside>
    </div>

    <FilterPanel Range="range" RangeChanged="r => range = r ?? Today()" OnShow="Load" OnClear="Reset" Busy="listBusy"
                 Title="@L.T("السندات")" Class="no-print">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string" @bind-Value="search" Label="@L.T("بحث")" Placeholder="@L.T("رقم السند أو اسم العميل")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" OnKeyDown="SearchKey" data-erp-search="true" />
        </MudItem>
    </FilterPanel>
    <EntityGrid T="PaymentRow" Items="rows" Title="@L.T("سندات القبض")" Export="export" ExportName="@L.T("سندات القبض")"
                Loading="listBusy" Filterable="false" EmptyText="@L.T("لا توجد سندات في هذه الفترة")">
        <Columns>
            <PropertyColumn T="PaymentRow" TProperty="string" Property="r => r.PaymentNumber" Title="@L.T("رقم السند")" />
            <TemplateColumn T="PaymentRow" Title="@L.T("التاريخ")" SortBy="r => r.PaymentDate">
                <CellTemplate><bdi class="erp-num erp-nowrap" dir="ltr">@context.Item.PaymentDate.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</bdi></CellTemplate>
            </TemplateColumn>
            <PropertyColumn T="PaymentRow" TProperty="string" Property="r => r.CustomerName" Title="@L.T("العميل")" />
            <TemplateColumn T="PaymentRow" Title="@L.T("المبلغ")" SortBy="r => r.Amount" HeaderClass="erp-num" CellClass="erp-num">
                <CellTemplate>
                    <MoneyText Value="context.Item.Amount" />
                    @if (context.Item.CurrencyCode is { } cur && cur != currency)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            <bdi class="erp-num" dir="ltr">@ErpFormat.Money(context.Item.ForeignAmount) @cur</bdi>
                        </MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn T="PaymentRow" TProperty="string" Property="r => r.MethodName" Title="@L.T("طريقة الدفع")" />
            <PropertyColumn T="PaymentRow" TProperty="string" Property="r => r.Notes" Title="@L.T("ملاحظات")" />
            <PropertyColumn T="PaymentRow" TProperty="string" Property="r => r.EmployeeName" Title="@L.T("المستخدم")" />
        </Columns>
    </EntityGrid>
}

@code {
    private sealed record CustomerChoice(int Id, string Name, decimal Balance);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? user;
    private bool allowed, loaded, busy, listBusy;
    private string denied = "", notes = "", message = "", currency = "";
    private string? search;
    private Severity severity = Severity.Info;
    private int customerId, methodId = 1, cashCustomer;
    private decimal amount;
    private DateRange range = Today();
    private List<PaymentRow> rows = [];
    private List<CustomerChoice> customers = [];
    private List<(int Id, string Name)> methods = [];
    private List<GridExport<PaymentRow>> export = [];
    private LookupField<CustomerChoice>? customerField;

    private CustomerChoice? Customer => customers.FirstOrDefault(c => c.Id == customerId);

    /// <summary>The period the Access list opens on: today.</summary>
    private static DateRange Today() => new(DateTime.Today, DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(UserInfo.EmployeeId(user), "frmCustomerPayment");
        allowed = denied.Length == 0;
        loaded = true;
        if (!allowed)
        {
            return;
        }
        export =
        [
            new(L.T("رقم السند"), r => r.PaymentNumber),
            new(L.T("التاريخ"), r => r.PaymentDate.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)),
            new(L.T("العميل"), r => r.CustomerName),
            new(L.T("المبلغ"), r => r.Amount),
            new(L.T("العملة"), r => r.CurrencyCode ?? currency),
            new(L.T("المبلغ بالعملة"), r => r.ForeignAmount),
            new(L.T("طريقة الدفع"), r => r.MethodName),
            new(L.T("ملاحظات"), r => r.Notes),
            new(L.T("المستخدم"), r => r.EmployeeName),
        ];
        (_, _, cashCustomer, currency) = await Sales.SaleSettingsAsync();
        await LoadCustomers();
        methods = await Sales.PaymentMethodsAsync(L.English);
        await Load();
    }

    /// <summary>The customers a voucher is for: every active customer but the cash customer.</summary>
    private async Task LoadCustomers() =>
        customers = (await Sales.CustomersAsync(L.English)).Where(c => c.Id != cashCustomer)
                                                           .Select(c => new CustomerChoice(c.Id, c.Name, c.Balance)).ToList();

    private async Task Load()
    {
        listBusy = true;
        try
        {
            rows = await Sales.PaymentsAsync(range.Start ?? DateTime.Today, range.End ?? DateTime.Today, search, L.English);
        }
        finally
        {
            listBusy = false;
        }
    }

    private async Task Reset()
    {
        range = Today();
        search = null;
        await Load();
    }

    private async Task SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Load();
        }
    }

    private void Show(string text, Severity kind)
    {
        message = text;
        severity = kind;
    }

    private async Task New()
    {
        customerId = 0;
        amount = 0;
        notes = "";
        message = "";
        if (customerField is not null)
        {
            await customerField.FocusAsync();
        }
    }

    private async Task Save(bool confirmed)
    {
        if (busy)
        {
            return;
        }
        message = "";
        if (customerId == 0)
        {
            Show(WorkPages.ChooseCustomer, Severity.Error);
            return;
        }
        busy = true;
        try
        {
            var r = await Sales.PostPaymentAsync(UserInfo.Acting(user), new PaymentRequest(customerId, amount, methodId, notes), confirmed);
            if (r.Status == SaveStatus.NeedsConfirmation)
            {
                busy = false;
                if (await ConfirmDialog.AskAsync(Dialogs, L.T("تأكيد"), L.T(r.Message), L.T("نعم"), Color.Primary))
                {
                    await Save(true);
                }
                return;
            }
            if (r.Status == SaveStatus.Refused)
            {
                Show(r.Message, Severity.Error);
                return;
            }
            Show(WorkPages.PaymentSaved + r.InvoiceNumber, Severity.Success);
            amount = 0;
            notes = "";
            await LoadCustomers();
            await Load();
        }
        finally
        {
            busy = false;
        }
    }
}
