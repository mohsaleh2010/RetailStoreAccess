@page "/pos"
@attribute [Authorize]
@using RetailStore.Domain.Sales
@inject SalesService Sales
@inject PermissionService Permissions
@inject UiLanguage L

<PageTitle>@L.T("نقطة البيع")</PageTitle>

<section class="screen">
    <header class="screen-head">
        <div>
            <h1>@L.T("نقطة البيع")</h1>
            <p class="subtitle">@L.T("فاتورة بيع: الأصناف بالباركود أو الاسم، والعميل، والدفع")</p>
        </div>
        @if (allowed && lines.Count > 0)
        {
            <button class="btn" @onclick="Clear">@L.T("فاتورة جديدة")</button>
        }
    </header>

    @if (!allowed)
    {
        <div class="message error" role="alert">@L.T(denied)</div>
    }
    else
    {
        <div class="pos">
            <div class="pos-cart list-pane">
                <form class="pos-scan" @onsubmit="Find" @onsubmit:preventDefault>
                    <input type="search" class="search" placeholder="@L.T("ابحث عن صنف أو اكتب الباركود")"
                           aria-label="@L.T("ابحث عن صنف أو اكتب الباركود")" @bind="code" @bind:event="oninput" autofocus />
                    <button type="submit" class="btn">@L.T("إضافة")</button>
                </form>
                @if (choices.Count > 0)
                {
                    <ul class="pos-choices">
                        @foreach (var p in choices)
                        {
                            <li><button class="btn link" @onclick="() => Add(p)">@p.ProductName (@p.ProductCode) - @WorkPages.Money(p.Price)</button></li>
                        }
                    </ul>
                }
                <table class="list pos-lines">
                    <thead>
                        <tr>
                            <th>@L.T("الصنف")</th>
                            <th>@L.T("الوحدة")</th>
                            <th>@L.T("الكمية")</th>
                            <th>@L.T("السعر")</th>
                            <th>@L.T("الخصم")</th>
                            <th>@L.T("الإجمالي")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < lines.Count; i++)
                        {
                            var line = lines[i];
                            int index = i;
                            <tr>
                                <td data-label="@L.T("الصنف")">@line.Name</td>
                                <td data-label="@L.T("الوحدة")">
                                    @if (line.Units.Count > 1)
                                    {
                                        <select aria-label="@L.T("الوحدة")" @onchange="e => UnitChanged(line, e.Value)">
                                            @foreach (var u in line.Units)
                                            {
                                                <option value="@u.UnitID" selected="@(u.UnitID == line.UnitID)">@u.UnitName</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        @line.UnitName
                                    }
                                </td>
                                <td data-label="@L.T("الكمية")"><input type="number" step="any" min="0" aria-label="@L.T("الكمية")" @bind="line.Quantity" @bind:after="Recalc" /></td>
                                <td data-label="@L.T("السعر")"><input type="number" step="any" min="0" aria-label="@L.T("السعر")" @bind="line.Price" @bind:after="Recalc" /></td>
                                <td data-label="@L.T("الخصم")"><input type="number" step="any" min="0" aria-label="@L.T("الخصم")" @bind="line.Discount" @bind:after="Recalc" /></td>
                                <td data-label="@L.T("الإجمالي")">@WorkPages.Money(LineTotal(index))</td>
                                <td><button class="btn link" aria-label="@L.T("حذف")" @onclick="() => Remove(index)">&#10005;</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (lines.Count == 0)
                {
                    <p class="empty">@L.T("امسح الباركود أو ابحث عن صنف لإضافته")</p>
                }
            </div>

            <div class="pos-pay form-pane">
                <div class="record">
                    <div class="field span-2">
                        <label for="pos-customer">@L.T("العميل")</label>
                        <select id="pos-customer" @onchange="CustomerChanged">
                            @foreach (var c in customers)
                            {
                                <option value="@c.Id" selected="@(c.Id == customerId)">@c.Name</option>
                            }
                        </select>
                        @if (customerId != cashCustomer)
                        {
                            <span class="hint">@L.T("الرصيد"): @WorkPages.Money(customers.FirstOrDefault(c => c.Id == customerId).Balance)</span>
                        }
                    </div>
                    <div class="field">
                        <label for="pos-type">@L.T("نوع الدفع")</label>
                        <select id="pos-type" @bind="paymentType">
                            <option value="CASH">@L.T("نقدي")</option>
                            <option value="CREDIT">@L.T("آجل")</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="pos-method">@L.T("طريقة الدفع")</label>
                        <select id="pos-method" @bind="methodId">
                            @foreach (var m in methods)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="pos-discount">@L.T("خصم الفاتورة")</label>
                        <input id="pos-discount" type="number" step="any" min="0" @bind="invoiceDiscount" @bind:after="Recalc" />
                    </div>
                    <div class="field">
                        <label for="pos-tendered">@L.T("المبلغ المدفوع")</label>
                        <input id="pos-tendered" type="number" step="any" min="0" @bind="tendered" @bind:after="Recalc" placeholder="@WorkPages.Money(paymentType == "CREDIT" ? 0 : calc?.Total ?? 0)" />
                    </div>
                    <div class="field span-2">
                        <label for="pos-notes">@L.T("ملاحظات")</label>
                        <input id="pos-notes" type="text" maxlength="255" @bind="notes" />
                    </div>
                </div>
                <dl class="totals">
                    <dt>@L.T("قبل الضريبة")</dt><dd>@WorkPages.Money(calc?.Taxable ?? 0)</dd>
                    <dt>@L.T("الخصم")</dt><dd>@WorkPages.Money(calc?.Discount ?? 0)</dd>
                    <dt>@L.T("ضريبة القيمة المضافة")</dt><dd>@WorkPages.Money(calc?.Tax ?? 0)</dd>
                    <dt class="grand">@L.T("الإجمالي")</dt><dd class="grand">@WorkPages.Money(calc?.Total ?? 0) @currency</dd>
                    @if (Change > 0)
                    {
                        <dt>@L.T("الباقي للعميل")</dt><dd>@WorkPages.Money(Change)</dd>
                    }
                </dl>
                @if (calc is { Ok: false } && lines.Count > 0)
                {
                    <div class="message warning">@L.T(calc.Problem)</div>
                }
                <div class="actions">
                    <button class="btn primary" disabled="@(busy || lines.Count == 0)" @onclick="() => Save(false)">@L.T("حفظ الفاتورة")</button>
                </div>
            </div>
        </div>
    }

    @if (message.Length > 0)
    {
        <div class="message @messageKind" role="status">
            @L.T(message)
            @if (savedId > 0)
            {
                <a href="sales/@savedId">@L.T("عرض الفاتورة وطباعتها")</a>
            }
        </div>
    }

    @if (question is not null)
    {
        <div class="dialog-backdrop">
            <div class="dialog" role="dialog" aria-modal="true">
                <p>@L.T(question)</p>
                <div class="actions">
                    <button class="btn primary" @onclick="() => Answer(true)">@L.T("نعم")</button>
                    <button class="btn" @onclick="() => Answer(false)">@L.T("لا")</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private sealed class Line
    {
        public int ProductID;
        public string Name = "";
        public int? UnitID;
        public string UnitName = "";
        public List<UnitChoice> Units = [];
        public decimal Quantity = 1;
        public decimal Price;
        public decimal ListPrice;            // the price the program gave the line (repriced with the customer)
        public decimal Discount;
        public string VatCategory = "S";
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? user;
    private bool allowed, busy;
    private string denied = "", code = "", paymentType = "CASH", notes = "", currency = "", message = "", messageKind = "";
    private string? question;
    private int customerId, cashCustomer, methodId = 1, savedId;
    private decimal invoiceDiscount;
    private decimal? tendered;
    private decimal vatRate;
    private bool includeVat;
    private List<Line> lines = [];
    private List<SaleProduct> choices = [];
    private List<(int Id, string Name, decimal Balance, bool AllowCredit)> customers = [];
    private List<(int Id, string Name)> methods = [];
    private CalcResult? calc;

    private int EmployeeId => UserInfo.EmployeeId(user);

    protected override async Task OnInitializedAsync()
    {
        user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(EmployeeId, "frmPOS");
        allowed = denied.Length == 0;
        if (!allowed)
        {
            return;
        }
        (vatRate, includeVat, cashCustomer, currency) = await Sales.SaleSettingsAsync();
        customerId = cashCustomer;
        customers = await Sales.CustomersAsync(L.English);
        methods = await Sales.PaymentMethodsAsync(L.English);
    }

    private async Task Find()
    {
        message = "";
        choices = await Sales.FindProductsAsync(EmployeeId, code, customerId, L.English);
        if (choices.Count == 0)
        {
            message = WorkPages.NoProduct;
            messageKind = "warning";
        }
        else if (choices.Count == 1)
        {
            await Add(choices[0]);
        }
    }

    private async Task Add(SaleProduct p)
    {
        choices = [];
        code = "";
        var same = lines.FirstOrDefault(l => l.ProductID == p.ProductID && l.UnitID == p.UnitID);
        if (same is not null)
        {
            same.Quantity += 1;
        }
        else
        {
            var units = await Sales.UnitsAsync(p.ProductID, L.English);
            int baseUnit = units.Count > 0 ? units[0].UnitID : 0;
            lines.Add(new Line
            {
                ProductID = p.ProductID, Name = p.ProductName, UnitID = p.UnitID ?? baseUnit, UnitName = p.UnitName, Units = units,
                Price = p.Price, ListPrice = p.Price, VatCategory = p.VATCategory,
            });
        }
        Recalc();
    }

    private async Task UnitChanged(Line line, object? value)
    {
        if (int.TryParse(value?.ToString(), out int unit))
        {
            line.UnitID = unit;
            line.UnitName = line.Units.FirstOrDefault(u => u.UnitID == unit)?.UnitName ?? "";
            line.Price = line.ListPrice = await Sales.LinePriceAsync(EmployeeId, line.ProductID, unit, customerId);
            Recalc();
        }
    }

    /// <summary>modPOS.RepriceCart: the lines still at the price the program gave them take the price of the new customer.</summary>
    private async Task CustomerChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int id))
        {
            return;
        }
        customerId = id;
        foreach (var line in lines.Where(l => l.Price == l.ListPrice))
        {
            line.Price = line.ListPrice = await Sales.LinePriceAsync(EmployeeId, line.ProductID, line.UnitID, customerId);
        }
        Recalc();
    }

    private void Remove(int index)
    {
        lines.RemoveAt(index);
        Recalc();
    }

    private void Recalc() =>
        calc = lines.Count == 0 ? null
            : InvoiceCalculator.Calc(lines.Select(l => new CalcLineIn(l.Quantity, l.Price, l.Discount, l.VatCategory == "S" ? vatRate : 0)).ToList(),
                                     invoiceDiscount, includeVat);

    private decimal LineTotal(int index) => calc is { Ok: true } c && index < c.Lines.Count ? c.Lines[index].Total : 0;

    private decimal Change => calc is { Ok: true } c && tendered is { } t && t > c.Total ? t - c.Total : 0;

    private void Clear()
    {
        lines = [];
        choices = [];
        invoiceDiscount = 0;
        tendered = null;
        notes = "";
        calc = null;
    }

    private async Task Save(bool confirmed)
    {
        busy = true;
        message = "";
        savedId = 0;
        try
        {
            var r = await Sales.PostSaleAsync(UserInfo.Acting(user),
                new SaleRequest(customerId, paymentType, methodId, invoiceDiscount, tendered, notes,
                                lines.Select(l => new CartLine(l.ProductID, l.Quantity, l.Price, l.Discount, l.UnitID)).ToList()),
                confirmed);
            if (r.Status == SaveStatus.NeedsConfirmation)
            {
                question = r.Message;
                return;
            }
            if (r.Status == SaveStatus.Refused)
            {
                message = r.Message;
                messageKind = "error";
                return;
            }
            savedId = r.InvoiceID;
            message = WorkPages.InvoiceSaved + r.InvoiceNumber + (r.Change > 0 ? WorkPages.ChangeDue + WorkPages.Money(r.Change) : "");
            messageKind = "success";
            Clear();
            customers = await Sales.CustomersAsync(L.English);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Answer(bool yes)
    {
        question = null;
        if (yes)
        {
            await Save(true);
        }
    }
}
