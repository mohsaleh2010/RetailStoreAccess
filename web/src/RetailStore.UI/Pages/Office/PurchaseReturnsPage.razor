@page "/purchase-returns"
@attribute [Authorize]
@inject SalesService Sales
@inject PurchaseService Purchases
@inject PermissionService Permissions
@inject UiLanguage L

@* The purchase return on the web (docs/87): frmPurchaseReturn, modPurchases.PostPurchaseReturn. *@
<PageTitle>@L.T("مرتجعات المشتريات")</PageTitle>

<section class="screen">
    <header class="screen-head">
        <div>
            <h1>@L.T("مرتجعات المشتريات")</h1>
            <p class="subtitle">@L.T("إرجاع أصناف فاتورة شراء للمورد: نقدًا أو خصمًا من المستحق له")</p>
        </div>
    </header>

    @if (!allowed)
    {
        <div class="message error" role="alert">@L.T(denied)</div>
    }
    else
    {
        <div class="pos">
            <div class="list-pane">
                <form class="list-tools" @onsubmit="FindAsync" @onsubmit:preventDefault>
                    <input type="search" class="search" placeholder="@L.T("رقم الفاتورة أو رقم فاتورة المورد")" aria-label="@L.T("رقم الفاتورة أو رقم فاتورة المورد")" @bind="number" />
                    <button type="submit" class="btn">@L.T("بحث")</button>
                </form>
                @if (invoice is { } inv)
                {
                    <p class="hint">@inv.InvoiceNumber · @inv.InvoiceDate.ToString("yyyy-MM-dd") · @inv.SupplierName · @L.T("فاتورة المورد"): @(inv.SupplierInvoiceNo ?? "-") · @WorkPages.Money(inv.TotalAmount) · @L.T(WorkPages.PaymentTypeName(inv.PaymentType))</p>
                    <table class="list">
                        <thead>
                            <tr>
                                <th>@L.T("الصنف")</th>
                                <th>@L.T("المشترى")</th>
                                <th>@L.T("المرتجع سابقًا")</th>
                                <th>@L.T("المتاح للإرجاع")</th>
                                <th>@L.T("الكمية المرتجعة")</th>
                                <th>@L.T("بالمخزون")</th>
                                <th>@L.T("القيمة")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in inv.Lines)
                            {
                                <tr>
                                    <td data-label="@L.T("الصنف")">@l.ProductName</td>
                                    <td data-label="@L.T("المشترى")">@WorkPages.Qty(l.BoughtQty)</td>
                                    <td data-label="@L.T("المرتجع سابقًا")">@WorkPages.Qty(l.ReturnedQty)</td>
                                    <td data-label="@L.T("المتاح للإرجاع")">@WorkPages.Qty(l.AvailableQty)</td>
                                    <td data-label="@L.T("الكمية المرتجعة")">
                                        <input type="number" step="any" min="0" value="@qty[l.PurchaseDetailID]" @onchange="e => SetQty(l, e.Value)" />
                                    </td>
                                    <td data-label="@L.T("بالمخزون")">@WorkPages.Qty(l.InStock)</td>
                                    <td data-label="@L.T("القيمة")">@WorkPages.Money(Amount(l))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="actions">
                        <button class="btn" @onclick="All">@L.T("إرجاع الكل")</button>
                    </div>
                }
                <h2>@L.T("المرتجعات")</h2>
                <table class="list">
                    <thead><tr><th>@L.T("المرتجع")</th><th>@L.T("التاريخ")</th><th>@L.T("المورد")</th><th>@L.T("الفاتورة")</th><th>@L.T("القيمة")</th></tr></thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            <tr>
                                <td data-label="@L.T("المرتجع")">@r.Number</td>
                                <td data-label="@L.T("التاريخ")">@r.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td data-label="@L.T("المورد")">@r.PartyName</td>
                                <td data-label="@L.T("الفاتورة")">@r.InvoiceNumber</td>
                                <td data-label="@L.T("القيمة")">@WorkPages.Money(r.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (rows.Count == 0)
                {
                    <p class="empty">@L.T("لا توجد سجلات")</p>
                }
            </div>

            <div class="form-pane">
                <h2>@L.T("مرتجع للمورد")</h2>
                @if (invoice is { } h)
                {
                    <form class="record" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                        <div class="field span-2">
                            <label for="sr-reason">@L.T("سبب الإرجاع") *</label>
                            <input id="sr-reason" type="text" maxlength="255" @bind="reason" />
                        </div>
                        <div class="field span-2">
                            <label for="sr-refund">@L.T("طريقة رد المبلغ")</label>
                            <select id="sr-refund" @bind="refund">
                                <option value="CASH">@L.T("استرداد نقدي من المورد")</option>
                                <option value="CREDIT">@L.T("خصم من المستحق للمورد")</option>
                            </select>
                        </div>
                        @if (refund == "CASH")
                        {
                            <div class="field span-2">
                                <label for="sr-method">@L.T("طريقة الدفع")</label>
                                <select id="sr-method" @bind="method">
                                    @foreach (var m in methods)
                                    {
                                        <option value="@m.Id">@m.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="field span-2">
                            <label>@L.T("قيمة المرتجع")</label>
                            <p class="total">@WorkPages.Money(h.Lines.Sum(Amount))</p>
                        </div>
                        <div class="actions span-2">
                            <button type="submit" class="btn primary" disabled="@busy">@L.T("حفظ المرتجع")</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="hint">@L.T("اكتب رقم فاتورة الشراء ثم «بحث».")</p>
                }
            </div>
        </div>
    }

    @if (message.Length > 0)
    {
        <div class="message @messageKind" role="status">@L.T(message)</div>
    }

    @if (question.Length > 0)
    {
        <div class="dialog-backdrop">
            <div class="dialog" role="dialog" aria-modal="true">
                <p>@L.T(question)</p>
                <div class="actions">
                    <button class="btn primary" @onclick="Yes">@L.T("نعم")</button>
                    <button class="btn" @onclick="@(() => question = "")">@L.T("لا")</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? user;
    private bool allowed, busy;
    private string denied = "", message = "", messageKind = "", number = "", reason = "", refund = "CREDIT";
    private int method = 1;
    private bool confirm;
    private string question = "";
    private PurchaseReturnable? invoice;
    private Dictionary<int, decimal> qty = [];
    private List<(int Id, string Name)> methods = [];
    private List<ReturnRow> rows = [];

    protected override async Task OnInitializedAsync()
    {
        user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(UserInfo.EmployeeId(user), "frmPurchaseReturn");
        allowed = denied.Length == 0;
        if (!allowed)
        {
            return;
        }
        methods = await Sales.PaymentMethodsAsync(L.English);
        await LoadListAsync();
    }

    private async Task LoadListAsync() => rows = await Purchases.PurchaseReturnsAsync(DateTime.Today.AddDays(1 - DateTime.Today.Day), DateTime.Today, L.English);

    private async Task FindAsync()
    {
        message = "";
        invoice = await Purchases.ReturnableAsync(number, L.English);
        if (invoice is null)
        {
            (message, messageKind) = (L.T("لا توجد فاتورة شراء بهذا الرقم."), "error");
            return;
        }
        qty = invoice.Lines.ToDictionary(l => l.PurchaseDetailID, _ => 0m);
        refund = invoice.DefaultRefund;          // LoadPurchaseForReturn: still owed -> deducted, paid -> cash back
    }

    private decimal Amount(PurchaseReturnableLine l) => qty.GetValueOrDefault(l.PurchaseDetailID) is > 0 and var q && l.Amounts(q) is { Problem.Length: 0 } a ? a.Total : 0;

    private void SetQty(PurchaseReturnableLine l, object? value)
    {
        decimal.TryParse(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture), System.Globalization.NumberStyles.Number,
                         System.Globalization.CultureInfo.InvariantCulture, out var q);
        q = Math.Max(0, q);
        if (q > l.AvailableQty)
        {
            (message, messageKind) = (L.T("الكمية المرتجعة أكبر من المتاح للإرجاع (") + WorkPages.Qty(l.AvailableQty) + ").", "error");
            q = l.AvailableQty;
        }
        qty[l.PurchaseDetailID] = q;
    }

    private void All()
    {
        foreach (var l in invoice!.Lines)
        {
            qty[l.PurchaseDetailID] = l.AvailableQty;
        }
    }

    private async Task Yes()
    {
        question = "";
        confirm = true;
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        message = "";
        busy = true;
        try
        {
            var req = new PurchaseReturnRequest(invoice!.PurchaseInvoiceID, reason, refund, method,
                                                invoice.Lines.Select(l => new PurchaseReturnLineRequest(l.PurchaseDetailID, qty[l.PurchaseDetailID])).ToArray());
            var r = await Purchases.PostPurchaseReturnAsync(UserInfo.Acting(user), req, confirm);
            confirm = false;
            if (r.Status == SaveStatus.NeedsConfirmation)
            {
                question = r.Message;
                return;
            }
            if (r.Status != SaveStatus.Saved)
            {
                (message, messageKind) = (r.Message, "error");
                return;
            }
            (message, messageKind) = (WorkPages.PurchaseReturnSaved + r.InvoiceNumber + " - " + WorkPages.Money(r.Total), "success");
            reason = "";
            invoice = null;
            await LoadListAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
