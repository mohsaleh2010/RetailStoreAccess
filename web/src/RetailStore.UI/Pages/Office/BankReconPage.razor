@page "/bank-reconciliation"
@attribute [Authorize]
@inject BankReconService Recon
@inject TreasuryService Treasury
@inject PermissionService Permissions
@inject UiLanguage L

@* The bank reconciliation on the web (docs/87): frmBankRecon, modBank.OpenReconciliation ... FinishReconciliation. *@
<PageTitle>@L.T("التسوية البنكية")</PageTitle>

<section class="screen">
    <header class="screen-head">
        <div>
            <h1>@L.T("التسوية البنكية")</h1>
            <p class="subtitle">@L.T("مطابقة كشف البنك مع الدفاتر واعتماد التسوية")</p>
        </div>
    </header>

    @if (!allowed)
    {
        <div class="message error" role="alert">@L.T(denied)</div>
    }
    else
    {
        <div class="pos">
            <div class="list-pane">
                <form class="list-tools" @onsubmit="StartAsync" @onsubmit:preventDefault>
                    <label class="check">@L.T("البنك")
                        <select value="@bankId" @onchange="e => BankAsync(e.Value)">
                            <option value="0"></option>
                            @foreach (var b in banks)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </label>
                    <label class="check">@L.T("تاريخ الكشف") <input type="date" @bind="statementDate" /></label>
                    <label class="check">@L.T("رصيد الكشف") <input type="number" step="any" @bind="statementBalance" /></label>
                    <button type="submit" class="btn primary" disabled="@busy">@L.T("بدء التسوية")</button>
                </form>

                @if (view is { } v)
                {
                    <p class="hint">@L.T(BankReconService.StateText(v))</p>
                    <h2>@L.T("عمليات لم تظهر في كشف بعد")</h2>
                    <table class="list">
                        <thead><tr><th></th><th>@L.T("التاريخ")</th><th>@L.T("العملية")</th><th>@L.T("الرقم")</th><th>@L.T("البيان")</th><th>@L.T("وارد")</th><th>@L.T("صادر")</th></tr></thead>
                        <tbody>
                            @foreach (var i in v.Open)
                            {
                                <tr>
                                    <td><input type="checkbox" disabled="@(!isOpen)" checked="@picked.Contains(i.Key)" @onchange="() => Toggle(i.Key)" /></td>
                                    <td data-label="@L.T("التاريخ")">@i.ItemDate.ToString("yyyy-MM-dd")</td>
                                    <td data-label="@L.T("العملية")">@i.TypeName</td>
                                    <td data-label="@L.T("الرقم")">@i.ItemNumber</td>
                                    <td data-label="@L.T("البيان")">@i.ItemText</td>
                                    <td data-label="@L.T("وارد")">@(i.ItemAmount > 0 ? WorkPages.Money(i.ItemAmount) : "")</td>
                                    <td data-label="@L.T("صادر")">@(i.ItemAmount < 0 ? WorkPages.Money(-i.ItemAmount) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (isOpen)
                    {
                        <div class="actions"><button class="btn" disabled="@busy" @onclick="() => ApplyAsync(true)">@L.T("مطابقة")</button></div>
                    }
                    <h2>@L.T("عمليات ظهرت في هذا الكشف")</h2>
                    <table class="list">
                        <thead><tr><th></th><th>@L.T("التاريخ")</th><th>@L.T("العملية")</th><th>@L.T("الرقم")</th><th>@L.T("وارد")</th><th>@L.T("صادر")</th></tr></thead>
                        <tbody>
                            @foreach (var i in v.Cleared)
                            {
                                <tr>
                                    <td><input type="checkbox" disabled="@(!isOpen)" checked="@picked.Contains(i.Key)" @onchange="() => Toggle(i.Key)" /></td>
                                    <td data-label="@L.T("التاريخ")">@i.ItemDate.ToString("yyyy-MM-dd")</td>
                                    <td data-label="@L.T("العملية")">@i.TypeName</td>
                                    <td data-label="@L.T("الرقم")">@i.ItemNumber</td>
                                    <td data-label="@L.T("وارد")">@(i.ItemAmount > 0 ? WorkPages.Money(i.ItemAmount) : "")</td>
                                    <td data-label="@L.T("صادر")">@(i.ItemAmount < 0 ? WorkPages.Money(-i.ItemAmount) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (isOpen)
                    {
                        <div class="actions"><button class="btn" disabled="@busy" @onclick="() => ApplyAsync(false)">@L.T("إلغاء المطابقة")</button></div>
                    }
                }
                else
                {
                    <p class="hint">@L.T("اختر البنك، واكتب تاريخ كشف البنك ورصيده، ثم «بدء التسوية».")</p>
                }
            </div>

            <div class="form-pane">
                @if (view is { } f)
                {
                    <h2>@f.Recon.ReconNumber</h2>
                    <table class="list">
                        <tbody>
                            <tr><td>@L.T("رصيد الكشف")</td><td>@WorkPages.Money(f.Recon.StatementBalance)</td></tr>
                            <tr><td>@L.T("الرصيد في الدفاتر")</td><td>@WorkPages.Money(f.Figures.Book)</td></tr>
                            <tr><td>@L.T("عمليات لم تظهر في الكشف")</td><td>@WorkPages.Money(f.Figures.Outstanding)</td></tr>
                            <tr><td>@L.T("الرصيد المعدل")</td><td>@WorkPages.Money(f.Figures.Adjusted)</td></tr>
                            <tr><th>@L.T("الفرق")</th><th class="@(f.Figures.Difference == 0 ? "ok" : "bad")">@WorkPages.Money(f.Figures.Difference)</th></tr>
                        </tbody>
                    </table>
                    <div class="actions">
                        @if (isOpen)
                        {
                            <button class="btn primary" disabled="@busy" @onclick="FinishAsync">@L.T("اعتماد التسوية")</button>
                            <button class="btn" disabled="@busy" @onclick="@(() => asking = "DELETE")">@L.T("حذف التسوية")</button>
                        }
                        else
                        {
                            <button class="btn" disabled="@busy" @onclick="@(() => asking = "REOPEN")">@L.T("إعادة فتح")</button>
                        }
                        <a class="btn" href="bank-transactions">@L.T("حركة بنكية")</a>
                    </div>
                }
                <h2>@L.T("التسويات")</h2>
                <table class="list">
                    <thead><tr><th>@L.T("التسوية")</th><th>@L.T("تاريخ الكشف")</th><th>@L.T("رصيد الكشف")</th><th>@L.T("حالة التسوية")</th></tr></thead>
                    <tbody>
                        @foreach (var r in recons)
                        {
                            <tr class="clickable" @onclick="() => ShowAsync(r.ReconciliationID)">
                                <td data-label="@L.T("التسوية")">@r.ReconNumber</td>
                                <td data-label="@L.T("تاريخ الكشف")">@r.StatementDate.ToString("yyyy-MM-dd")</td>
                                <td data-label="@L.T("رصيد الكشف")">@WorkPages.Money(r.StatementBalance)</td>
                                <td data-label="@L.T("حالة التسوية")">@L.T(r.Status == "DONE" ? "معتمدة" : "جارية")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (message.Length > 0)
    {
        <div class="message @messageKind" role="status">@L.T(message)</div>
    }

    @if (asking.Length > 0)
    {
        <div class="dialog-backdrop">
            <div class="dialog" role="dialog" aria-modal="true">
                <p>@L.T(asking == "DELETE" ? "حذف التسوية الجارية وكل مطابقاتها؟" : "إعادة فتح التسوية المعتمدة؟")</p>
                <div class="actions">
                    <button class="btn primary" @onclick="AnswerAsync">@L.T("نعم")</button>
                    <button class="btn" @onclick="@(() => asking = "")">@L.T("لا")</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? user;
    private bool allowed, busy;
    private string denied = "", message = "", messageKind = "", asking = "";
    private int bankId;
    private DateTime? statementDate;
    private decimal? statementBalance;
    private List<(int Id, string Name)> banks = [];
    private List<ReconRow> recons = [];
    private ReconView? view;
    private HashSet<string> picked = [];

    private bool isOpen => view?.Recon.Status == "OPEN";

    protected override async Task OnInitializedAsync()
    {
        user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(UserInfo.EmployeeId(user), BankReconService.Form);
        allowed = denied.Length == 0;
        if (!allowed)
        {
            return;
        }
        string sync = await Recon.SyncAsync(UserInfo.Acting(user));        // BankReconLoad: the journal first
        if (sync.Length > 0)
        {
            (message, messageKind) = (sync, "error");
        }
        banks = await Treasury.BanksAsync(L.English);
        if (banks.Count > 0)
        {
            await BankAsync(banks[0].Id.ToString());
        }
    }

    /// <summary>BankReconBankChanged: the open reconciliation of the bank, if there is one.</summary>
    private async Task BankAsync(object? value)
    {
        bankId = int.TryParse(value as string, out var id) ? id : 0;
        view = null;
        picked.Clear();
        recons = bankId > 0 ? await Recon.ReconsAsync(bankId) : [];
        var open = recons.FirstOrDefault(r => r.Status == "OPEN");
        if (open is not null)
        {
            await ShowAsync(open.ReconciliationID);
        }
        else
        {
            statementDate = DateTime.Today.AddDays(-DateTime.Today.Day);          // the end of last month
            statementBalance = null;
        }
    }

    private async Task ShowAsync(int id)
    {
        picked.Clear();
        view = await Recon.ViewAsync(id, L.English);
        if (view is not null)
        {
            statementDate = view.Recon.StatementDate;
            statementBalance = view.Recon.StatementBalance;
        }
    }

    private async Task StartAsync()
    {
        message = "";
        if (bankId == 0)
        {
            (message, messageKind) = ("اختر البنك.", "error");
            return;
        }
        if (statementBalance is null)
        {
            (message, messageKind) = ("اكتب الرصيد الظاهر في كشف البنك في هذا التاريخ.", "error");
            return;
        }
        var r = await Recon.OpenAsync(UserInfo.Acting(user), bankId, statementDate, statementBalance.Value);
        if (r.Status != SaveStatus.Saved)
        {
            (message, messageKind) = (r.Message, "error");
            return;
        }
        recons = await Recon.ReconsAsync(bankId);
        await ShowAsync(r.Id);
    }

    private void Toggle(string key)
    {
        if (!picked.Remove(key))
        {
            picked.Add(key);
        }
    }

    /// <summary>ApplyToSelected: tick (or untick) the chosen operations.</summary>
    private async Task ApplyAsync(bool clearing)
    {
        message = "";
        var list = clearing ? view!.Open : view!.Cleared;
        var chosen = list.Where(i => picked.Contains(i.Key)).ToList();
        if (chosen.Count == 0)
        {
            (message, messageKind) = ("اختر عملية أو أكثر من القائمة.", "error");
            return;
        }
        busy = true;
        try
        {
            foreach (var i in chosen)
            {
                string msg = clearing ? await Recon.ClearAsync(view.Recon.ReconciliationID, i.SourceType, i.SourceID)
                                      : await Recon.UnclearAsync(view.Recon.ReconciliationID, i.SourceType, i.SourceID);
                if (msg.Length > 0)
                {
                    (message, messageKind) = (msg, "error");
                    break;
                }
            }
            await ShowAsync(view.Recon.ReconciliationID);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task FinishAsync()
    {
        string msg = await Recon.FinishAsync(UserInfo.Acting(user), view!.Recon.ReconciliationID);
        (message, messageKind) = msg.Length > 0 ? (msg, "error") : (WorkPages.ReconFinished, "success");
        recons = await Recon.ReconsAsync(bankId);
        await ShowAsync(view.Recon.ReconciliationID);
    }

    private async Task AnswerAsync()
    {
        string what = asking;
        asking = "";
        int id = view!.Recon.ReconciliationID;
        string msg = what == "DELETE" ? await Recon.DeleteAsync(UserInfo.Acting(user), id) : await Recon.ReopenAsync(UserInfo.Acting(user), id);
        if (msg.Length > 0)
        {
            (message, messageKind) = (msg, "error");
        }
        recons = await Recon.ReconsAsync(bankId);
        if (what == "DELETE" && msg.Length == 0)
        {
            view = null;
        }
        else
        {
            await ShowAsync(id);
        }
    }
}
