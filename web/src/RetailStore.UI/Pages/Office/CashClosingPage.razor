@page "/cash-closing"
@attribute [Authorize]
@inject TreasuryService Treasury
@inject PosService Pos
@inject PermissionService Permissions
@inject UiLanguage L

@* The cashier closing on the web (docs/87): frmCashClosing, modCash.PostCashClosing. *@
<PageTitle>@L.T("تصفية يومية الكاشير")</PageTitle>

<section class="screen">
    <header class="screen-head">
        <div>
            <h1>@L.T("تصفية يومية الكاشير")</h1>
            <p class="subtitle">@L.T("الرصيد الدفتري للصندوق من آخر تصفية، والنقدية الفعلية، والعجز أو الزيادة، والترحيل للخزينة")</p>
        </div>
    </header>

    @if (!allowed)
    {
        <div class="message error" role="alert">@L.T(denied)</div>
    }
    else
    {
        <div class="pos">
            <div class="list-pane">
                <div class="list-tools">
                    <label class="check">@L.T("الصندوق")
                        <select value="@boxId" @onchange="e => ChooseAsync(e.Value)">
                            @foreach (var b in boxes)
                            {
                                <option value="@b.CashBoxID">@b.BoxName</option>
                            }
                        </select>
                    </label>
                </div>
                @if (preview is { } p)
                {
                    <p class="hint">@(p.PeriodStart is { } since
                        ? L.T("من آخر تصفية") + ": " + since.ToString("yyyy-MM-dd HH:mm")
                        : L.T("من بداية الصندوق (لا توجد تصفية سابقة)")) · @L.T("حتى الآن")</p>
                    <table class="list">
                        <tbody>
                            <tr><td>@L.T("رصيد البداية")</td><td>@WorkPages.Money(p.Opening)</td></tr>
                            <tr><td>@L.T("المقبوضات")</td><td>@WorkPages.Money(p.CashIn)</td></tr>
                            <tr><td>@L.T("المدفوعات")</td><td>@WorkPages.Money(p.CashOut)</td></tr>
                            <tr><th>@L.T("الرصيد الدفتري")</th><th>@WorkPages.Money(p.Expected)</th></tr>
                        </tbody>
                    </table>
                    <table class="list">
                        <thead><tr><th>@L.T("البند")</th><th>@L.T("العدد")</th><th>@L.T("مقبوض")</th><th>@L.T("مدفوع")</th></tr></thead>
                        <tbody>
                            @foreach (var line in p.Breakdown)
                            {
                                <tr>
                                    <td data-label="@L.T("البند")">@line.MoveTypeName</td>
                                    <td data-label="@L.T("العدد")">@line.Count</td>
                                    <td data-label="@L.T("مقبوض")">@WorkPages.Money(line.AmountIn)</td>
                                    <td data-label="@L.T("مدفوع")">@WorkPages.Money(line.AmountOut)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="form-pane">
                <h2>@L.T("النقدية الفعلية")</h2>
                @if (preview is not null)
                {
                    <form class="record" @onsubmit="Ask" @onsubmit:preventDefault>
                        <div class="field span-2">
                            <label for="cc-counted">@L.T("النقدية الفعلية") *</label>
                            <input id="cc-counted" type="number" step="any" min="0" @bind="counted" />
                            <p class="hint">@DiffText</p>
                        </div>
                        <div class="field span-2">
                            <label for="cc-dest">@L.T("الترحيل إلى")</label>
                            <select id="cc-dest" @bind="destination">
                                <option value="MAIN">@L.T("ترحيل إلى الخزينة الرئيسية")</option>
                                <option value="OWNER">@L.T("تسليم للمالك (تسوية)")</option>
                                <option value="KEEP">@L.T("يبقى في الصندوق")</option>
                            </select>
                        </div>
                        @if (destination == "MAIN")
                        {
                            <div class="field span-2">
                                <label for="cc-safe">@L.T("الخزينة المستلمة")</label>
                                <select id="cc-safe" @bind="toBox">
                                    @foreach (var b in safes)
                                    {
                                        <option value="@b.CashBoxID">@b.BoxName</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (destination != "KEEP")
                        {
                            <div class="field">
                                <label for="cc-transfer">@L.T("المبلغ المرحَّل")</label>
                                <input id="cc-transfer" type="number" step="any" min="0" @bind="transfer" />
                            </div>
                        }
                        <div class="field">
                            <label>@L.T("يبقى في الصندوق (عهدة الكاشير)")</label>
                            <p>@WorkPages.Money((counted ?? 0) - (destination == "KEEP" ? 0 : transfer ?? 0))</p>
                        </div>
                        <div class="field span-2">
                            <label for="cc-notes">@L.T("ملاحظات")</label>
                            <input id="cc-notes" type="text" maxlength="255" @bind="notes" />
                        </div>
                        <div class="actions span-2">
                            <button type="submit" class="btn primary" disabled="@(busy || counted is null)">@L.T("حفظ التصفية")</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }

    @if (message.Length > 0)
    {
        <div class="message @messageKind" role="status">@L.T(message)</div>
    }

    @if (asking)
    {
        <div class="dialog-backdrop">
            <div class="dialog" role="dialog" aria-modal="true">
                <p>@(L.T("حفظ تصفية") + " " + preview?.BoxName + "؟")<br />@DiffText<br />@L.T("لا يمكن تعديل التصفية بعد الحفظ.")</p>
                <div class="actions">
                    <button class="btn primary" @onclick="SaveAsync">@L.T("نعم")</button>
                    <button class="btn" @onclick="() => asking = false">@L.T("لا")</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? user;
    private bool allowed, busy, asking;
    private string denied = "", message = "", messageKind = "", destination = "MAIN", notes = "";
    private int boxId, toBox;
    private decimal? counted, transfer;
    private List<ClosingBox> boxes = [], safes = [];
    private ClosingPreview? preview;

    protected override async Task OnInitializedAsync()
    {
        user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(UserInfo.EmployeeId(user), TreasuryService.ClosingForm);
        allowed = denied.Length == 0;
        if (!allowed)
        {
            return;
        }
        var b = await Pos.ClosingBoxesAsync(UserInfo.EmployeeId(user), L.English);
        (boxes, safes) = (b.Boxes, b.Safes);
        toBox = safes.FirstOrDefault()?.CashBoxID ?? 0;
        await LoadAsync(b.DefaultBoxID > 0 ? b.DefaultBoxID : boxes.FirstOrDefault()?.CashBoxID ?? 0);
    }

    private async Task LoadAsync(int id)
    {
        boxId = id;
        preview = id > 0 ? await Treasury.ClosingPreviewAsync(id, L.English) : null;
        counted = null;
        transfer = null;
    }

    private async Task ChooseAsync(object? value) => await LoadAsync(int.TryParse(value as string, out var id) ? id : 0);

    private decimal Difference => (counted ?? 0) - (preview?.Expected ?? 0);

    /// <summary>modCash.ClosingRecalc.</summary>
    private string DiffText => counted is null ? L.T("أدخل النقدية الموجودة فعلًا في الصندوق")
        : Difference < 0 ? L.T("عجز") + ": " + WorkPages.Money(-Difference)
        : Difference > 0 ? L.T("زيادة") + ": " + WorkPages.Money(Difference)
        : L.T("مطابق: لا يوجد عجز ولا زيادة");

    private void Ask()
    {
        message = "";
        transfer ??= counted;                   // all the counted cash goes on unless typed otherwise
        asking = counted is not null;
    }

    private async Task SaveAsync()
    {
        asking = false;
        busy = true;
        try
        {
            var r = await Treasury.PostCashClosingAsync(UserInfo.Acting(user),
                new CashClosingRequest(boxId, counted ?? 0, destination, destination == "MAIN" ? toBox : null,
                                       destination == "KEEP" ? 0 : transfer ?? 0, notes));
            if (r.Status != SaveStatus.Saved)
            {
                (message, messageKind) = (r.Message, "error");
                return;
            }
            (message, messageKind) = (WorkPages.ClosingSaved + r.Number, "success");
            notes = "";
            await LoadAsync(boxId);
        }
        finally
        {
            busy = false;
        }
    }
}
