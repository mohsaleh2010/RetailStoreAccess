@page "/ledger"
@attribute [Authorize]
@inject AccountingService Accounting
@inject PermissionService Permissions
@inject IJSRuntime JS
@inject UiLanguage L

@* Template C of the redesign (docs/ui-inventory.md section 8): PageHeader (print) -> FilterPanel (the account and the
   period) -> the four figures (opening, debit, credit, closing) -> EntityGrid of the lines with the CSV export. The
   statement is AccountingService.LedgerAsync (modLedger.FillLedger over AccountStatementQuery), its checks and messages. *@
<PageHeader Title="@L.T("كشف حساب ودفتر الأستاذ")" Description="@L.T("رصيد أول المدة، ثم كل سطر قيد بالرصيد بعده")"
            Icon="@NavGroups.IconOf("ledger")" Group="@L.T("الحسابات")">
    <Actions>
        @if (ledger is not null)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Print" OnClick="Print">
                @L.T("طباعة")<kbd class="erp-kbd">Ctrl+P</kbd>
            </MudButton>
        }
    </Actions>
</PageHeader>

@if (!allowed)
{
    @if (loaded)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@L.T(denied)</MudAlert>
    }
}
else
{
    <FilterPanel Range="range" RangeChanged="r => range = r" OnShow="Load" OnClear="Reset" Busy="busy" Class="no-print">
        <MudItem xs="12" sm="6" md="5">
            <LookupField T="AccountChoice" Label="@L.T("الحساب")" Items="accounts" Value="Account" ValueChanged="AccountChanged"
                         CodeOf="a => a.AccountCode.ToString(System.Globalization.CultureInfo.InvariantCulture)" NameOf="a => a.AccountName"
                         Placeholder="@L.T("اختر الحساب، ثم الفترة.")" MaxItems="40">
                <InfoTemplate Context="a">
                    @if (!a.IsPosting)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="erp-chip-inactive">@L.T("رئيسي")</MudChip>
                    }
                </InfoTemplate>
            </LookupField>
        </MudItem>
    </FilterPanel>

    @if (message.Length > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" role="alert">@L.T(message)</MudAlert>
    }

    @if (ledger is null)
    {
        @if (message.Length == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.ListAlt" Title="@L.T("اختر الحساب، ثم الفترة.")"
                        Text="@L.T("رصيد أول المدة، ثم كل سطر قيد بالرصيد بعده")" />
        }
    }
    else
    {
        <MudText Typo="Typo.subtitle1" Class="mb-3 erp-print-title">
            <bdi class="erp-num">@ledger.AccountCode</bdi> - @ledger.AccountName
            <span class="mud-text-secondary erp-num" dir="ltr">(@ErpFormat.Date(range.Start) - @ErpFormat.Date(range.End))</span>
        </MudText>
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Title="@L.T("رصيد أول المدة")" Value="@L.T(AccountingService.BalanceText(ledger.Opening))"
                          Icon="@Icons.Material.Outlined.Flag" Color="Color.Info" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Title="@L.T("مدين")" Icon="@Icons.Material.Outlined.SouthWest" Color="Color.Primary"
                          Subtitle="@(ledger.LineCount + " " + L.T("سطر قيد"))">
                    <ValueContent><MoneyText Value="ledger.Debit" ColorNegative="false" /></ValueContent>
                </StatCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Title="@L.T("دائن")" Icon="@Icons.Material.Outlined.NorthEast" Color="Color.Secondary">
                    <ValueContent><MoneyText Value="ledger.Credit" ColorNegative="false" /></ValueContent>
                </StatCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Title="@L.T("الرصيد")" Value="@L.T(AccountingService.BalanceText(ledger.Closing))"
                          Icon="@Icons.Material.Outlined.AccountBalance" Color="Color.Tertiary" />
            </MudItem>
        </MudGrid>
        @if (ledger.IsMain)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text" Class="mb-3">@L.T("حساب رئيسي: يشمل كل حساباته التابعة")</MudAlert>
        }
        <EntityGrid T="LedgerLine" Items="ledger.Lines" Title="@L.T("سطور القيود")" Export="export" ExportName="@L.T("كشف حساب")"
                    SearchText="l => l.EntryNo + ' ' + l.KindName + ' ' + l.DocNo + ' ' + l.Details + ' ' + l.SubName"
                    RowsPerPage="50" Filterable="false" RowClass="@((l, _) => l.EntryRef == 0 ? "erp-row-opening" : "")">
            <Columns>
                <PropertyColumn T="LedgerLine" TProperty="DateTime" Property="l => l.LineDate" Title="@L.T("التاريخ")" Format="yyyy-MM-dd"
                                CellClass="erp-num" Culture="System.Globalization.CultureInfo.InvariantCulture" />
                <PropertyColumn T="LedgerLine" TProperty="string" Property="l => l.EntryNo" Title="@L.T("القيد")" />
                <PropertyColumn T="LedgerLine" TProperty="string" Property="l => l.KindName" Title="@L.T("العملية")" />
                <PropertyColumn T="LedgerLine" TProperty="string" Property="l => l.DocNo" Title="@L.T("المستند")" />
                <PropertyColumn T="LedgerLine" TProperty="string" Property="l => l.Details" Title="@L.T("البيان")" />
                <PropertyColumn T="LedgerLine" TProperty="string" Property="l => l.SubName" Title="@L.T("الحساب")" />
                <TemplateColumn T="LedgerLine" Title="@L.T("مدين")" SortBy="l => l.Debit" HeaderClass="erp-num" CellClass="erp-num">
                    <CellTemplate>@if (context.Item.Debit != 0) { <MoneyText Value="context.Item.Debit" ColorNegative="false" /> }</CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="LedgerLine" Title="@L.T("دائن")" SortBy="l => l.Credit" HeaderClass="erp-num" CellClass="erp-num">
                    <CellTemplate>@if (context.Item.Credit != 0) { <MoneyText Value="context.Item.Credit" ColorNegative="false" /> }</CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="LedgerLine" Title="@L.T("الرصيد")" Sortable="false" HeaderClass="erp-num" CellClass="erp-num">
                    <CellTemplate><bdi class="erp-money">@L.T(AccountingService.BalanceText(context.Item.Balance))</bdi></CellTemplate>
                </TemplateColumn>
            </Columns>
        </EntityGrid>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "account")] public int? AccountParam { get; set; }
    private bool allowed, loaded, busy;
    private string denied = "", message = "";
    private int account;
    private DateRange range = DefaultRange();
    private List<AccountChoice> accounts = [];
    private LedgerView? ledger;
    private List<GridExport<LedgerLine>> export = [];

    private AccountChoice? Account => accounts.FirstOrDefault(a => a.AccountCode == account);

    /// <summary>The period of the Access screen: from the first of the year to today.</summary>
    private static DateRange DefaultRange() => new(new DateTime(DateTime.Today.Year, 1, 1), DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(UserInfo.EmployeeId(user), "frmLedger");
        allowed = denied.Length == 0;
        loaded = true;
        if (allowed)
        {
            export =
            [
                new(L.T("التاريخ"), l => ErpFormat.Date(l.LineDate)),
                new(L.T("القيد"), l => l.EntryNo),
                new(L.T("العملية"), l => l.KindName),
                new(L.T("المستند"), l => l.DocNo),
                new(L.T("البيان"), l => l.Details),
                new(L.T("الحساب"), l => l.SubName),
                new(L.T("مدين"), l => l.Debit),
                new(L.T("دائن"), l => l.Credit),
                new(L.T("الرصيد"), l => l.Balance),
            ];
            accounts = await Accounting.AccountsAsync(L.English);
            account = AccountParam ?? 0;
            await Load();
        }
    }

    private async Task AccountChanged(AccountChoice? a)
    {
        account = a?.AccountCode ?? 0;
        await Load();
    }

    private async Task Reset()
    {
        range = DefaultRange();
        account = 0;
        await Load();
    }

    private async Task Load()
    {
        message = "";
        ledger = null;
        if (account == 0)
        {
            return;
        }
        message = AccountingService.PeriodProblem(range.Start, range.End);
        if (message.Length == 0)
        {
            busy = true;
            try
            {
                ledger = await Accounting.LedgerAsync(account, range.Start!.Value, range.End!.Value, L.English);
            }
            finally
            {
                busy = false;
            }
        }
    }

    private async Task Print() => await JS.InvokeVoidAsync("print");
}
