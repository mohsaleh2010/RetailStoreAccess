@page "/purchase"
@attribute [Authorize]
@using RetailStore.Domain.Sales
@inject PurchaseService Purchases
@inject SalesService Sales
@inject StockService Stock
@inject PermissionService Permissions
@inject UiLanguage L

@* Template B of the redesign (docs/ui-inventory.md section 8), as /pos: PageHeader (new invoice, save) -> the head of the
   purchase (scan, supplier, his invoice number, date, warehouse, VAT, payment) -> InvoiceLinesEditor (the unit of each
   line with its last cost from the service, the purchase price WITHOUT VAT, and the new selling price in ExtraColumn) ->
   the totals card, sticky beside the lines on a large screen and under them on a small one. The checks, costs and posting
   stay those of PurchaseService (modPurchases.PostPurchaseFromCart). *@
<PageHeader Title="@L.T("فاتورة شراء")" Description="@L.T("الأصناف بسعر الشراء ووحدتها، والمورد، والدفع، والمخزن")"
            Icon="@NavGroups.IconOf("purchase")" Group="@L.T("المشتريات")">
    <Status>
        @if (allowed)
        {
            <StatusChip Status="DRAFT" />
        }
    </Status>
    <Actions>
        @if (allowed)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.NoteAdd" OnClick="Clear" Disabled="busy">
                @L.T("فاتورة جديدة")<kbd class="erp-kbd">F4</kbd>
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save"
                       OnClick="Save" Disabled="busy || Filled.Count == 0">
                @L.T("حفظ الفاتورة")<kbd class="erp-kbd">F2</kbd>
            </MudButton>
        }
    </Actions>
</PageHeader>

@if (!allowed)
{
    @if (loaded)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@L.T(denied)</MudAlert>
    }
}
else
{
    <KeyboardShortcuts OnSave="Save" OnNew="Clear" />
    @if (message.Length > 0)
    {
        <MudAlert Severity="@severity" Variant="Variant.Outlined" Class="mb-4" role="status" ShowCloseIcon="true"
                  CloseIconClicked="() => message = string.Empty">
            @L.T(message)
            @if (savedId > 0)
            {
                <MudLink Href="@($"purchases/{savedId}")" Class="ms-2">@L.T("عرض الفاتورة")</MudLink>
            }
        </MudAlert>
    }
    <div class="erp-doc">
        <div class="erp-doc-main">
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @ref="scan" @bind-Value="code" Label="@L.T("ابحث عن صنف أو اكتب الباركود")"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Outlined.QrCodeScanner" Immediate="true" AutoFocus="true"
                                      OnKeyDown="ScanKey" data-erp-search="true" Clearable="true" HelperText="@L.T("Enter للإضافة")" />
                        @if (choices.Count > 0)
                        {
                            <MudPaper Outlined="true" Class="erp-pos-choices mt-1">
                                <MudList T="PurchaseProduct" Dense="true">
                                    @foreach (var p in choices)
                                    {
                                        <MudListItem T="PurchaseProduct" OnClick="() => Add(p)">
                                            <div class="erp-lookup-item">
                                                <span class="erp-lookup-code erp-num">@p.ProductCode</span>
                                                <span class="erp-lookup-name">@p.ProductName</span>
                                                <span class="erp-lookup-info"><MoneyText Value="p.Cost" /></span>
                                            </div>
                                        </MudListItem>
                                    }
                                </MudList>
                            </MudPaper>
                        }
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <LookupField T="SupplierChoice" Label="@L.T("المورد")" Items="suppliers" Value="Supplier"
                                     ValueChanged="s => supplierId = s?.Id ?? 0" NameOf="s => s.Name" Required="true"
                                     HelperText="@(Supplier is { } s ? L.T("الرصيد") + ": " + ErpFormat.Money(s.Balance) : "")">
                            <InfoTemplate Context="s"><MoneyText Value="s.Balance" /></InfoTemplate>
                        </LookupField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" @bind-Value="supplierNo" Label="@L.T("رقم فاتورة المورد")" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" MaxLength="30" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker @bind-Date="invoiceDate" Label="@L.T("تاريخ الفاتورة")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       DateFormat="yyyy-MM-dd" Culture="@ErpFormat.DateCulture(L.English)" AutoClose="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" @bind-Value="warehouseId" Label="@L.T("المخزن")" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Dense="true">
                            @foreach (var w in warehouses)
                            {
                                <MudSelectItem T="int" Value="@w.Id">@w.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                        <MudCheckBox T="bool" Value="chargeVat" ValueChanged="VatChanged" Color="Color.Primary" Dense="true"
                                     Label="@L.T("بضريبة القيمة المضافة")" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string" @bind-Value="paymentType" Label="@L.T("نوع الدفع")" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Dense="true">
                            <MudSelectItem T="string" Value="@("CASH")">@L.T("نقدي")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("CREDIT")">@L.T("آجل")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" @bind-Value="methodId" Label="@L.T("طريقة الدفع")" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Dense="true">
                            @foreach (var m in methods)
                            {
                                <MudSelectItem T="int" Value="@m.Id">@m.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="notes" Label="@L.T("ملاحظات")" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" MaxLength="255" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <InvoiceLinesEditor TProduct="PurchaseProduct" Lines="lines" SearchProducts="SearchProducts" CodeOf="p => p.ProductCode"
                                NameOf="p => p.ProductName" PriceOf="p => p.Cost" VatRateOf="RateOf" VatRate="@(chargeVat ? vatRate : 0)"
                                PricesIncludeVat="false" InvoiceDiscount="invoiceDiscount" OnProductPicked="Picked"
                                OnChange="_ => StateHasChanged()" ShowSummary="false" ShowVat="false" Class="erp-lines-compact"
                                ExtraColumnTitle="@L.T("سعر البيع الجديد")">
                <InfoTemplate Context="p"><MoneyText Value="p.Cost" /></InfoTemplate>
                <UnitTemplate Context="line">
                    @{ var tag = TagOf(line); }
                    @if (tag.Units.Count > 1)
                    {
                        <MudSelect T="int" Value="tag.UnitID ?? 0" ValueChanged="u => UnitChanged(line, u)" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Dense="true" aria-label="@L.T("الوحدة")">
                            @foreach (var u in tag.Units)
                            {
                                <MudSelectItem T="int" Value="@u.UnitID">@u.UnitName</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <span>@tag.UnitName</span>
                    }
                </UnitTemplate>
                <ExtraColumn Context="line">
                    @{ var tag = TagOf(line); }
                    <MudNumericField T="decimal?" Value="tag.NewPrice" ValueChanged="v => tag.NewPrice = v" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" HideSpinButtons="true" Min="0" Format="0.00##" Class="erp-cell-num"
                                     Placeholder="@ErpFormat.Money(tag.SellingPrice)" Culture="System.Globalization.CultureInfo.InvariantCulture"
                                     aria-label="@L.T("سعر البيع الجديد")" />
                </ExtraColumn>
            </InvoiceLinesEditor>
            @if (Filled.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.QrCodeScanner" Title="@L.T("الفاتورة فارغة")"
                            Text="@L.T("امسح الباركود أو ابحث عن صنف لإضافته")" Class="erp-empty-compact" />
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">@L.T("أسعار الشراء بدون الضريبة")</MudText>
            }
        </div>

        <aside class="erp-doc-side">
            <MudPaper Outlined="true" Class="pa-4 erp-summary">
                <MudText Typo="Typo.h6" Class="mb-3">@L.T("ملخص الفاتورة")</MudText>
                <MudNumericField T="decimal" @bind-Value="invoiceDiscount" Label="@L.T("خصم الفاتورة")" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" HideSpinButtons="true" Min="0" Format="0.00" Class="erp-cell-num mb-3"
                                 Culture="System.Globalization.CultureInfo.InvariantCulture" />
                <MudNumericField T="decimal?" @bind-Value="paid" Label="@L.T("المبلغ المدفوع")" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" HideSpinButtons="true" Min="0" Format="0.00" Class="erp-cell-num mb-3"
                                 Placeholder="@ErpFormat.Money(paymentType == "CREDIT" ? 0 : Calc.Total)"
                                 Culture="System.Globalization.CultureInfo.InvariantCulture" />
                <dl class="erp-summary-list">
                    <dt>@L.T("قبل الضريبة")</dt><dd><MoneyText Value="Calc.Taxable" /></dd>
                    <dt>@L.T("الخصم")</dt><dd><MoneyText Value="Calc.Discount" /></dd>
                    <dt>@L.T("ضريبة القيمة المضافة")</dt><dd><MoneyText Value="Calc.Tax" /></dd>
                    <dt class="erp-summary-grand">@L.T("الإجمالي")</dt>
                    <dd class="erp-summary-grand"><MoneyText Value="Calc.Total" ShowCurrency="true" Bold="true" /></dd>
                </dl>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-3"
                           StartIcon="@Icons.Material.Outlined.Save" OnClick="Save" Disabled="busy || Filled.Count == 0">
                    @L.T("حفظ الفاتورة")
                </MudButton>
            </MudPaper>
        </aside>
    </div>
}

@code {
    /// <summary>What the page keeps with a line: its unit (the units of the item), the shelf price of that unit and the new
    /// selling price typed (null = unchanged), as tmpPurchaseLines.</summary>
    private sealed class LineTag
    {
        public int? UnitID;
        public string UnitName = "";
        public List<UnitChoice> Units = [];
        public decimal SellingPrice;
        public decimal? NewPrice;
    }

    private sealed record SupplierChoice(int Id, string Name, decimal Balance);

    private const string VatStandard = "S";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? user;
    private bool allowed, loaded, busy, chargeVat = true;
    private string denied = "", code = "", paymentType = "CASH", notes = "", message = "";
    private string? supplierNo;
    private Severity severity = Severity.Info;
    private int supplierId, methodId = 1, warehouseId, savedId;
    private decimal invoiceDiscount, vatRate;
    private decimal? paid;
    private DateTime? invoiceDate = DateTime.Today;
    private List<InvoiceLine<PurchaseProduct>> lines = [];
    private List<PurchaseProduct> choices = [];
    private List<SupplierChoice> suppliers = [];
    private List<(int Id, string Name)> methods = [], warehouses = [];
    private MudTextField<string>? scan;

    private int EmployeeId => UserInfo.EmployeeId(user);

    private SupplierChoice? Supplier => suppliers.FirstOrDefault(s => s.Id == supplierId);

    private List<InvoiceLine<PurchaseProduct>> Filled => lines.Where(l => !l.IsEmpty).ToList();

    /// <summary>The totals of the lines from the invoice engine (InvoiceCalculator = CalcRun, prices without VAT).</summary>
    private CalcResult Calc => InvoiceLines.Calculate(lines, invoiceDiscount, false);

    protected override async Task OnInitializedAsync()
    {
        user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(EmployeeId, "frmPurchaseInvoice");
        allowed = denied.Length == 0;
        loaded = true;
        if (!allowed)
        {
            return;
        }
        (vatRate, _, _) = await Purchases.PurchaseSettingsAsync();
        await LoadSuppliers();
        methods = await Sales.PaymentMethodsAsync(L.English);
        (warehouses, warehouseId) = await Stock.WarehousesAsync(EmployeeId, L.English);
    }

    private async Task LoadSuppliers() =>
        suppliers = (await Purchases.SuppliersAsync(L.English)).Select(s => new SupplierChoice(s.Id, s.Name, s.Balance)).ToList();

    private static LineTag TagOf(InvoiceLine<PurchaseProduct> line) => line.Tag as LineTag ?? new LineTag();

    /// <summary>The VAT of a line: the rate of the settings for a standard item when the invoice carries VAT, else none.</summary>
    private decimal RateOf(PurchaseProduct p) => chargeVat && p.VATCategory == VatStandard ? vatRate : 0;

    private void VatChanged(bool value)
    {
        chargeVat = value;
        foreach (var line in lines)
        {
            line.VatRate = line.Product is { } p ? RateOf(p) : (chargeVat ? vatRate : 0);
        }
    }

    private async Task<IEnumerable<PurchaseProduct>> SearchProducts(string? text, CancellationToken cancel) =>
        string.IsNullOrWhiteSpace(text) ? [] : await Purchases.FindProductsAsync(EmployeeId, text, L.English, warehouseId);

    private async Task ScanKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Find();
        }
    }

    private async Task Find()
    {
        message = "";
        if (string.IsNullOrWhiteSpace(code))
        {
            return;
        }
        choices = await Purchases.FindProductsAsync(EmployeeId, code, L.English, warehouseId);
        if (choices.Count == 0)
        {
            Show(WorkPages.NoProduct, Severity.Warning);
        }
        else if (choices.Count == 1)
        {
            await Add(choices[0]);
        }
    }

    /// <summary>A scanned or chosen item: one more of the same item and unit, else a new line before the empty one.</summary>
    private async Task Add(PurchaseProduct p)
    {
        choices = [];
        code = "";
        var same = Filled.FirstOrDefault(l => l.Product!.ProductID == p.ProductID && TagOf(l).UnitID == (p.UnitID ?? TagOf(l).Units.FirstOrDefault()?.UnitID));
        if (same is not null)
        {
            same.Quantity += 1;
        }
        else
        {
            var line = new InvoiceLine<PurchaseProduct> { Product = p, Quantity = 1, Price = p.Cost, VatRate = RateOf(p) };
            await Picked(line);
            int at = lines.Count > 0 && lines[^1].IsEmpty ? lines.Count - 1 : lines.Count;
            lines.Insert(at, line);
        }
        if (scan is not null)
        {
            await scan.FocusAsync();
        }
    }

    /// <summary>An item put on a line: its units, the unit of its code (a unit barcode) else the smallest, and the shelf
    /// price of that unit.</summary>
    private async Task Picked(InvoiceLine<PurchaseProduct> line)
    {
        var p = line.Product!;
        var units = await Sales.UnitsAsync(p.ProductID, L.English);
        int baseUnit = units.Count > 0 ? units[0].UnitID : 0;
        line.Tag = new LineTag { UnitID = p.UnitID ?? baseUnit, UnitName = p.UnitName, Units = units, SellingPrice = p.SellingPrice };
    }

    /// <summary>Another unit: its last cost and shelf price from the service; the new selling price typed is dropped.</summary>
    private async Task UnitChanged(InvoiceLine<PurchaseProduct> line, int unit)
    {
        var tag = TagOf(line);
        tag.UnitID = unit;
        tag.UnitName = tag.Units.FirstOrDefault(u => u.UnitID == unit)?.UnitName ?? "";
        (decimal cost, tag.SellingPrice) = await Purchases.LineCostAsync(line.Product!.ProductID, unit);
        line.Price = cost;
        tag.NewPrice = null;
    }

    private void Show(string text, Severity kind)
    {
        message = text;
        severity = kind;
    }

    private async Task Clear()
    {
        lines = [];
        choices = [];
        invoiceDiscount = 0;
        paid = null;
        notes = "";
        supplierNo = null;
        invoiceDate = DateTime.Today;
        if (scan is not null)
        {
            await scan.FocusAsync();
        }
    }

    private async Task Save()
    {
        if (busy || Filled.Count == 0)
        {
            return;
        }
        message = "";
        savedId = 0;
        if (supplierId == 0)
        {
            Show(WorkPages.ChooseSupplier, Severity.Error);
            return;
        }
        busy = true;
        try
        {
            var r = await Purchases.PostPurchaseAsync(UserInfo.Acting(user),
                new PurchaseRequest(supplierId, supplierNo, invoiceDate, paymentType, methodId, chargeVat, invoiceDiscount, paid, notes,
                                    Filled.Select(l => new PurchaseLine(l.Product!.ProductID, l.Quantity, l.Price, l.Discount, TagOf(l).UnitID, TagOf(l).NewPrice)).ToList(),
                                    WarehouseID: warehouseId));
            if (r.Status != SaveStatus.Saved)
            {
                Show(r.Message, Severity.Error);
                return;
            }
            savedId = r.InvoiceID;
            Show(WorkPages.PurchaseSaved + r.InvoiceNumber, Severity.Success);
            await Clear();
            await LoadSuppliers();
        }
        finally
        {
            busy = false;
        }
    }
}
