@page "/bank-transactions"
@attribute [Authorize]
@inject TreasuryService Treasury
@inject PermissionService Permissions
@inject UiLanguage L

<PageTitle>@L.T("الحركات البنكية")</PageTitle>

<section class="screen">
    <header class="screen-head">
        <div>
            <h1>@L.T("الحركات البنكية")</h1>
            <p class="subtitle">@L.T("أرصدة البنوك، والإيداع والسحب والتحويل وتسوية مدى")</p>
        </div>
    </header>

    @if (!allowed)
    {
        <div class="message error" role="alert">@L.T(denied)</div>
    }
    else
    {
        <div class="pos">
            <div class="list-pane">
                <table class="list">
                    <thead>
                        <tr>
                            <th>@L.T("البنك")</th>
                            <th>@L.T("رقم الحساب")</th>
                            <th>@L.T("الرصيد في الدفاتر")</th>
                            <th>@L.T("آخر حركة")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in banks)
                        {
                            <tr class="@(b.IsActive ? "" : "inactive")">
                                <td data-label="@L.T("البنك")">@b.BankName</td>
                                <td data-label="@L.T("رقم الحساب")">@b.AccountNo</td>
                                <td data-label="@L.T("الرصيد في الدفاتر")">@WorkPages.Money(b.Balance)</td>
                                <td data-label="@L.T("آخر حركة")">@b.LastItemDate?.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="hint">@L.T("الرصيد من القيود: يتحدث بعد تحديث القيود.")</p>

                <form class="list-tools" @onsubmit="Load" @onsubmit:preventDefault>
                    <label class="check">@L.T("من") <input type="date" @bind="from" /></label>
                    <label class="check">@L.T("إلى") <input type="date" @bind="to" /></label>
                    <button type="submit" class="btn">@L.T("عرض")</button>
                </form>
                <table class="list">
                    <thead>
                        <tr>
                            <th>@L.T("الرقم")</th>
                            <th>@L.T("التاريخ")</th>
                            <th>@L.T("نوع الحركة")</th>
                            <th>@L.T("البنك")</th>
                            <th>@L.T("الطرف الآخر")</th>
                            <th>@L.T("المبلغ")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            <tr>
                                <td data-label="@L.T("الرقم")">@r.TxNumber</td>
                                <td data-label="@L.T("التاريخ")">@r.TxDate.ToString("yyyy-MM-dd")</td>
                                <td data-label="@L.T("نوع الحركة")">@r.TxTypeName</td>
                                <td data-label="@L.T("البنك")">@r.BankName</td>
                                <td data-label="@L.T("الطرف الآخر")">@r.OtherName</td>
                                <td data-label="@L.T("المبلغ")">@WorkPages.Money(r.Amount)</td>
                                <td class="actions"><button class="btn" disabled="@busy" @onclick="() => Delete(r)">@L.T("حذف")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (rows.Count == 0)
                {
                    <p class="empty">@L.T("لا توجد سجلات")</p>
                }
            </div>

            <div class="form-pane">
                <h2>@L.T("حركة جديدة")</h2>
                <form class="record" @onsubmit="Save" @onsubmit:preventDefault>
                    <div class="field span-2">
                        <label for="bt-type">@L.T("نوع الحركة") *</label>
                        <select id="bt-type" @bind="txType">
                            @foreach (var t in TreasuryService.BankTxTypes)
                            {
                                <option value="@t">@L.T(TreasuryService.BankTxTypeName(t))</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="bt-date">@L.T("التاريخ") *</label>
                        <input id="bt-date" type="date" @bind="txDate" />
                    </div>
                    <div class="field">
                        <label for="bt-bank">@L.T("البنك") *</label>
                        <select id="bt-bank" @bind="bankId">
                            <option value="0"></option>
                            @foreach (var b in bankChoices)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    @if (txType is "DEPOSIT" or "WITHDRAW")
                    {
                        <div class="field span-2">
                            <label for="bt-box">@L.T("الصندوق") *</label>
                            <select id="bt-box" @bind="boxId">
                                <option value="0"></option>
                                @foreach (var b in boxes)
                                {
                                    <option value="@b.Id">@b.Name (@WorkPages.Money(b.Balance))</option>
                                }
                            </select>
                        </div>
                    }
                    else if (txType == "TRANSFER")
                    {
                        <div class="field span-2">
                            <label for="bt-to">@L.T("إلى البنك") *</label>
                            <select id="bt-to" @bind="toBankId">
                                <option value="0"></option>
                                @foreach (var b in bankChoices.Where(b => b.Id != bankId))
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else if (txType is "OTHER_IN" or "OTHER_OUT")
                    {
                        <div class="field span-2">
                            <label for="bt-account">@L.T("الحساب المقابل") *</label>
                            <select id="bt-account" @bind="counterAccount">
                                <option value="0"></option>
                                @foreach (var a in accounts)
                                {
                                    <option value="@a.Code">@a.Code @a.Name</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="field">
                        <label for="bt-amount">@L.T("المبلغ") *</label>
                        <input id="bt-amount" type="number" step="any" min="0" @bind="amount" />
                    </div>
                    @if (txType == "SETTLEMENT")
                    {
                        <div class="field">
                            <label for="bt-fee">@L.T("العمولة")</label>
                            <input id="bt-fee" type="number" step="any" min="0" @bind="fee" />
                        </div>
                    }
                    @if (txType is "SETTLEMENT" or "OTHER_OUT")
                    {
                        <div class="field">
                            <label for="bt-vat">@L.T("ضريبة المدخلات")</label>
                            <input id="bt-vat" type="number" step="any" min="0" @bind="feeVat" />
                        </div>
                    }
                    <div class="field">
                        <label for="bt-ref">@L.T("المرجع")</label>
                        <input id="bt-ref" type="text" maxlength="40" @bind="reference" />
                    </div>
                    <div class="field span-2">
                        <label for="bt-desc">@L.T("البيان")</label>
                        <input id="bt-desc" type="text" maxlength="255" @bind="description" />
                    </div>
                    <div class="actions span-2">
                        <button type="submit" class="btn primary" disabled="@busy">@L.T("حفظ الحركة")</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (message.Length > 0)
    {
        <div class="message @messageKind" role="status">@L.T(message)</div>
    }

    @if (toDelete is not null)
    {
        <div class="dialog-backdrop">
            <div class="dialog" role="dialog" aria-modal="true">
                <p>@L.T("حذف الحركة") @(toDelete.TxNumber)؟</p>
                <div class="actions">
                    <button class="btn primary" @onclick="() => Answer(true)">@L.T("نعم")</button>
                    <button class="btn" @onclick="() => Answer(false)">@L.T("لا")</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? user;
    private bool allowed, busy;
    private string denied = "", message = "", messageKind = "", txType = "DEPOSIT";
    private string? reference, description;
    private int bankId, toBankId, boxId, counterAccount;
    private decimal amount, fee, feeVat;
    private DateTime txDate = DateTime.Today, from = DateTime.Today.AddDays(1 - DateTime.Today.Day), to = DateTime.Today;
    private List<BankBalance> banks = [];
    private List<BankTxRow> rows = [];
    private BankTxRow? toDelete;
    private List<(int Id, string Name)> bankChoices = [];
    private List<(int Id, string Name, decimal Balance)> boxes = [];
    private List<(int Code, string Name)> accounts = [];

    protected override async Task OnInitializedAsync()
    {
        user = AuthState is null ? null : (await AuthState).User;
        denied = await Permissions.OpenProblemAsync(UserInfo.EmployeeId(user), "frmBankTx");
        allowed = denied.Length == 0;
        if (!allowed)
        {
            return;
        }
        bankChoices = await Treasury.BanksAsync(L.English);
        boxes = await Treasury.BoxesAsync(L.English);
        accounts = await Treasury.CounterAccountsAsync(L.English);
        boxId = await Treasury.UserBoxAsync(UserInfo.EmployeeId(user));
        await Load();
    }

    private async Task Load()
    {
        banks = await Treasury.BankBalancesAsync(L.English);
        rows = await Treasury.BankTxAsync(from, to, 0, L.English);
    }

    private async Task Save()
    {
        message = "";
        busy = true;
        try
        {
            var req = new BankTxRequest(txType, txDate, bankId, toBankId == 0 ? null : toBankId, boxId == 0 ? null : boxId,
                                        counterAccount == 0 ? null : counterAccount, amount, fee, feeVat, reference, description);
            var r = await Treasury.PostBankTxAsync(UserInfo.Acting(user), req);
            if (r.Status != SaveStatus.Saved)
            {
                message = r.Message;
                messageKind = "error";
                return;
            }
            message = r.Message.Length > 0 ? r.Message : WorkPages.BankTxSaved + r.Number;
            messageKind = r.Message.Length > 0 ? "error" : "success";
            amount = fee = feeVat = 0;
            reference = description = null;
            boxes = await Treasury.BoxesAsync(L.English);
            await Load();
        }
        finally
        {
            busy = false;
        }
    }

    private void Delete(BankTxRow r) => toDelete = r;

    private async Task Answer(bool yes)
    {
        var row = toDelete;
        toDelete = null;
        if (!yes || row is null)
        {
            return;
        }
        var r = await Treasury.DeleteBankTxAsync(UserInfo.Acting(user), row.BankTxID);
        message = r.Message;
        messageKind = "error";
        if (r.Status == SaveStatus.Saved)
        {
            message = r.Message.Length > 0 ? r.Message : WorkPages.BankTxDeleted + row.TxNumber;
            messageKind = r.Message.Length > 0 ? "error" : "success";
            boxes = await Treasury.BoxesAsync(L.English);
            await Load();
        }
    }
}
