<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The design system shared by the web, the Windows POS and the rep app (docs/ui-inventory.md section 17): the
       MudBlazor theme, the shared components, the language / currency / shortcut services, erp.css / erp.js and the
       Cairo font. It references RetailStore.Domain only, never RetailStore.Data (the rep app reaches the program
       only through the API, docs/78). The namespaces stay those of RetailStore.UI, so no page changes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>RetailStore.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetailStore.Domain\RetailStore.Domain.csproj" />
  </ItemGroup>

</Project>
