@page "/account/change-password"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize]
@layout AccountLayout
@inject SecurityService Security
@inject UiLanguage L
@inject NavigationManager Nav

<PageTitle>@L.T("تغيير كلمة المرور")</PageTitle>

<EditForm Model="Input" method="post" OnSubmit="Change" FormName="change-password" class="card">
    <h1>@L.T("تغيير كلمة المرور")</h1>
    @if (mustChange)
    {
        <p class="info">@L.T("يجب تغيير كلمة المرور قبل المتابعة.")</p>
    }
    <label for="old">@L.T("كلمة المرور الحالية")</label>
    <InputText id="old" type="password" @bind-Value="Input.Old" autocomplete="current-password" />
    <label for="new">@L.T("كلمة المرور الجديدة")</label>
    <InputText id="new" type="password" @bind-Value="Input.New" autocomplete="new-password" />
    <label for="confirm">@L.T("تأكيد كلمة المرور")</label>
    <InputText id="confirm" type="password" @bind-Value="Input.Confirm" autocomplete="new-password" />
    <button type="submit" class="btn primary">@L.T("حفظ")</button>
    @if (message.Length > 0)
    {
        <div class="message error" role="alert">@L.T(message)</div>
    }
    @if (!mustChange)
    {
        <a href="">@L.T("الرئيسية")</a>
    }
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = default!;
    private string message = "";
    private bool mustChange;

    protected override void OnInitialized()
    {
        Input ??= new();
        mustChange = UserInfo.MustChangePassword(HttpContext.User);
    }

    private async Task Change()
    {
        var user = UserInfo.Acting(HttpContext.User);
        message = await Security.ChangeOwnPasswordAsync(user, Input.Old ?? "", Input.New ?? "", Input.Confirm ?? "");
        if (message.Length > 0)
        {
            return;
        }
        // a new cookie without the "must change" mark
        await AccountEndpoints.SignInAsync(HttpContext, user.EmployeeID, UserInfo.Name(HttpContext.User), user.Computer, false);
        Nav.NavigateTo("", forceLoad: true);
    }

    private sealed class PasswordInput
    {
        public string? Old { get; set; }
        public string? New { get; set; }
        public string? Confirm { get; set; }
    }
}
