@page "/account/change-password"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize]
@layout AccountLayout
@inject SecurityService Security
@inject UiLanguage L
@inject NavigationManager Nav

@* A static page (it writes the cookie): a plain EditForm post, its fields named as InputText named them (Input.*). *@
<EditForm Model="Input" method="post" OnSubmit="Change" FormName="change-password">
    <PageHeader Title="@L.T("تغيير كلمة المرور")" Icon="@Icons.Material.Outlined.Password" />
    @if (mustChange)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">@L.T("يجب تغيير كلمة المرور قبل المتابعة.")</MudAlert>
    }
    @if (message.Length > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4" role="alert">@L.T(message)</MudAlert>
    }
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudTextField T="string" Value="Input.Old" Label="@L.T("كلمة المرور الحالية")" InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                          UserAttributes="@(Field("old", "Input.Old", "current-password", autofocus: true))" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Value="Input.New" Label="@L.T("كلمة المرور الجديدة")" InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                          UserAttributes="@(Field("new", "Input.New", "new-password"))" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Value="Input.Confirm" Label="@L.T("تأكيد كلمة المرور")" InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                          UserAttributes="@(Field("confirm", "Input.Confirm", "new-password"))" />
        </MudItem>
        <MudItem xs="12" Class="d-flex flex-wrap gap-2">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Save">@L.T("حفظ")</MudButton>
            @if (!mustChange)
            {
                <MudButton Variant="Variant.Outlined" Href="" StartIcon="@Icons.Material.Outlined.Home">@L.T("الرئيسية")</MudButton>
            }
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = default!;
    private string message = "";
    private bool mustChange;

    protected override void OnInitialized()
    {
        Input ??= new();
        mustChange = UserInfo.MustChangePassword(HttpContext.User);
    }

    private async Task Change()
    {
        var user = UserInfo.Acting(HttpContext.User);
        message = await Security.ChangeOwnPasswordAsync(user, Input.Old ?? "", Input.New ?? "", Input.Confirm ?? "");
        if (message.Length > 0)
        {
            return;
        }
        // a new cookie without the "must change" mark
        await AccountEndpoints.SignInAsync(HttpContext, user.EmployeeID, UserInfo.Name(HttpContext.User), user.Computer, false);
        Nav.NavigateTo("", forceLoad: true);
    }

    /// <summary>The attributes of a posted field: its id, the form name the model binds (Input.X) and the browser hints.</summary>
    // the first field is marked data-erp-autofocus: erp.js focuses it (MudBlazor's AutoFocus needs an interactive page).
    private static Dictionary<string, object?> Field(string id, string name, string autocomplete, bool autofocus = false)
    {
        var a = new Dictionary<string, object?> { ["id"] = id, ["name"] = name, ["autocomplete"] = autocomplete };
        if (autofocus)
        {
            a["data-erp-autofocus"] = "true";
        }
        return a;
    }

    private sealed class PasswordInput
    {
        public string? Old { get; set; }
        public string? New { get; set; }
        public string? Confirm { get; set; }
    }
}
