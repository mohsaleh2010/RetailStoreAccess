@page "/return"
@inject PosSession S
@inject UiLanguage L
@inject NavigationManager Nav

@* A sales return on the POS (docs/86), template B (redesign batch 7D, docs/ui-inventory.md section 21): PageHeader (new
   F4, save and print F9 / F2) -> the invoice by its number (Enter = search) and its facts, the reason, how the amount goes
   back -> the lines of the invoice with the quantity returned and "to stock" -> the card of the credit note beside them
   (its value from ReturnableLine.Amounts = modPOS.RecalcReturn, the big save button, print again). Saved on the program
   at once (modSales.PostSalesReturn through PosSession.SaveReturnAsync) and printed as a credit note; the checks and
   messages stay those of PosSession and the service. *@
<PageHeader Title="@L.T("مرتجع مبيعات")" Icon="@Icons.Material.Outlined.AssignmentReturn"
            Description="@L.T("إشعار دائن من رقم الفاتورة: الكمية المرتجعة، والرد نقدًا أو الخصم من الرصيد")">
    <Status>
        @if (Allowed && invoice is not null)
        {
            <StatusChip Status="DRAFT" />
        }
    </Status>
    <Actions>
        @if (Allowed)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Large" StartIcon="@Icons.Material.Outlined.NoteAdd" OnClick="NewAsync"
                       Disabled="@busy">
                @L.T("مرتجع جديد") <kbd class="erp-kbd">F4</kbd>
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Outlined.Print"
                       OnClick="SaveAsync" Disabled="@(busy || Total <= 0)">
                @L.T("حفظ وطباعة") <kbd class="erp-kbd">F9</kbd>
            </MudButton>
        }
    </Actions>
</PageHeader>

@if (!S.LoggedIn)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">@L.T("سجّل الدخول أولًا.")</MudAlert>
}
else if (!Allowed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="pos-pre" role="alert">@L.T(S.Snapshot!.User.ReturnProblem)</MudAlert>
}
else
{
    <KeyboardShortcuts OnSave="SaveAsync" OnNew="NewAsync" OnSearch="FocusNumberAsync" />
    @if (message.Length > 0)
    {
        <MudAlert Severity="@(error ? Severity.Error : Severity.Success)" Variant="Variant.Outlined" Class="mb-4 pos-pre"
                  role="@(error ? "alert" : "status")" ShowCloseIcon="true" CloseIconClicked="() => message = string.Empty">
            @message
        </MudAlert>
    }
    <div class="erp-doc pos-doc">
        <div class="erp-doc-main">
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <div class="pos-scan">
                    <MudTextField T="string" @ref="numberField" @bind-Value="number" Label="@L.T("رقم الفاتورة")"
                                  Variant="Variant.Outlined" Margin="Margin.Normal" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.ReceiptLong" Immediate="true" AutoFocus="true"
                                  OnKeyUp="KeyAsync" data-erp-search="true" Clearable="true" Class="pos-scan-box"
                                  HelperText="@L.T("Enter للبحث")" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Outlined.Search" OnClick="FindAsync" Disabled="@busy" Class="pos-scan-button">
                        @L.T("بحث")
                    </MudButton>
                </div>
                @if (invoice is { } h)
                {
                    <div class="erp-chips-row mt-3">
                        <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.ReceiptLong">
                            <bdi dir="ltr" class="erp-num">@h.InvoiceNumber</bdi>
                        </MudChip>
                        <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Event">
                            <bdi dir="ltr" class="erp-num">@h.InvoiceDate.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</bdi>
                        </MudChip>
                        <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Person">@h.CustomerName</MudChip>
                        <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Payments">
                            @(h.PaymentType == "CREDIT" ? L.T("آجل") : L.T("نقدي"))
                        </MudChip>
                    </div>
                    <MudGrid Spacing="3" Class="mt-1">
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="reason" Label="@L.T("سبب الإرجاع")" Variant="Variant.Outlined"
                                          Margin="Margin.Normal" MaxLength="255" Immediate="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="string" Value="Refund" ValueChanged="r => refund = r" Label="@L.T("طريقة رد المبلغ")"
                                       Variant="Variant.Outlined" Margin="Margin.Normal" Disabled="h.CashCustomer"
                                       AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem T="string" Value="@("CASH")">@L.T("رد نقدي")</MudSelectItem>
                                <MudSelectItem T="string" Value="@("CREDIT")">@L.T("خصم من رصيد العميل")</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        @if (Refund == "CASH")
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <MudSelect T="int" @bind-Value="method" Label="@L.T("طريقة الرد")" Variant="Variant.Outlined"
                                           Margin="Margin.Normal" AnchorOrigin="Origin.BottomCenter">
                                    @foreach (var m in S.Snapshot!.Methods)
                                    {
                                        <MudSelectItem T="int" Value="@m.PaymentMethodID">@m.MethodName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudPaper>

            @if (invoice is { } inv)
            {
                <EntityGrid T="ReturnableLine" Items="inv.Lines" Filterable="false" ShowPager="false" RowsPerPage="1000"
                            Title="@L.T("أسطر الفاتورة")" Class="pos-lines">
                    <ToolBarContent>
                        <MudButton Variant="Variant.Outlined" Size="Size.Large" StartIcon="@Icons.Material.Outlined.DoneAll" OnClick="ReturnAll">
                            @L.T("إرجاع الكل")
                        </MudButton>
                    </ToolBarContent>
                    <Columns>
                        <TemplateColumn T="ReturnableLine" Title="@L.T("الصنف")" Sortable="false">
                            <CellTemplate>
                                <span class="pos-line-name">@context.Item.ProductName</span>
                                <span class="pos-line-code">@context.Item.UnitName</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="ReturnableLine" Title="@L.T("المباع")" Sortable="false" HeaderClass="erp-num" CellClass="erp-num">
                            <CellTemplate><QtyText Value="context.Item.SoldQty" /></CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="ReturnableLine" Title="@L.T("المرتجع سابقًا")" Sortable="false" HeaderClass="erp-num pos-col-wide"
                                        CellClass="erp-num pos-col-wide">
                            <CellTemplate><QtyText Value="context.Item.ReturnedQty" /></CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="ReturnableLine" Title="@L.T("المتاح للإرجاع")" Sortable="false" HeaderClass="erp-num" CellClass="erp-num">
                            <CellTemplate><QtyText Value="context.Item.AvailableQty" /></CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="ReturnableLine" Title="@L.T("الكمية المرتجعة")" Sortable="false" CellClass="pos-col-num">
                            <CellTemplate>
                                @{ var line = context.Item; }
                                <MudNumericField T="decimal" Value="@qty.GetValueOrDefault(line.SalesDetailID)" ValueChanged="q => SetQty(line, q)"
                                                 Variant="Variant.Outlined" Margin="Margin.Normal" HideSpinButtons="true" Min="0"
                                                 Disabled="@(line.AvailableQty <= 0)" Class="erp-cell-num" Culture="CultureInfo.InvariantCulture"
                                                 aria-label="@L.T("الكمية المرتجعة")" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="ReturnableLine" Title="@L.T("إلى المخزون")" Sortable="false" CellClass="pos-col-check">
                            <CellTemplate>
                                @{ var line = context.Item; }
                                <MudCheckBox T="bool" Value="@ToStock(line)" ValueChanged="v => toStock[line.SalesDetailID] = v"
                                             Color="Color.Primary" Size="Size.Large" aria-label="@L.T("إلى المخزون")" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="ReturnableLine" Title="@L.T("القيمة")" Sortable="false" HeaderClass="erp-num" CellClass="erp-num pos-col-amount">
                            <CellTemplate>
                                @{ var amount = Amount(context.Item); }
                                @if (amount.Problem.Length == 0)
                                {
                                    <MoneyText Value="amount.Total" Bold="true" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </EntityGrid>
            }
            else
            {
                <EmptyState Icon="@Icons.Material.Outlined.AssignmentReturn" Title="@L.T("اكتب رقم الفاتورة ثم «بحث».")"
                            Text="@L.T("إشعار دائن من رقم الفاتورة: الكمية المرتجعة، والرد نقدًا أو الخصم من الرصيد")" />
            }
        </div>

        <aside class="erp-doc-side">
            <MudPaper Outlined="true" Class="pa-4 erp-summary">
                <MudText Typo="Typo.h6" Class="mb-3">@L.T("إشعار دائن")</MudText>
                <dl class="erp-summary-list">
                    <dt>@L.T("إجمالي الفاتورة")</dt><dd><MoneyText Value="invoice?.TotalAmount" /></dd>
                    <dt>@L.T("طريقة رد المبلغ")</dt>
                    <dd>@(invoice is null ? "" : Refund == "CASH" ? L.T("رد نقدي") : L.T("خصم من رصيد العميل"))</dd>
                    <dt class="erp-summary-grand pos-grand">@L.T("قيمة المرتجع")</dt>
                    <dd class="erp-summary-grand pos-grand"><MoneyText Value="Total" ShowCurrency="true" Bold="true" /></dd>
                </dl>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-4 pos-save"
                           StartIcon="@Icons.Material.Outlined.Print" OnClick="SaveAsync" Disabled="@(busy || Total <= 0)">
                    @L.T("حفظ وطباعة") <kbd class="erp-kbd">F9</kbd>
                </MudButton>
                @if (busy)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                }
                @if (last is not null)
                {
                    <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Large" Class="mt-3"
                               StartIcon="@Icons.Material.Outlined.Print" OnClick="ReprintAsync" Disabled="@busy">
                        @L.T("طباعة مرة أخرى") <bdi dir="ltr" class="erp-num pos-reprint-number">@last.Number</bdi>
                    </MudButton>
                }
            </MudPaper>
        </aside>
    </div>
}

@code {
    private string number = "", reason = "", refund = "CASH", message = "", reference = "";
    private int method = SalesService.CashMethodId;
    private bool busy, error;
    private ReturnableInvoice? invoice;
    private PosDocument? last;
    private bool lastCash;
    private readonly Dictionary<int, decimal> qty = [];
    private readonly Dictionary<int, bool> toStock = [];
    private MudTextField<string>? numberField;

    private bool Allowed => S.Snapshot?.User.ReturnProblem.Length == 0;

    private string Refund => invoice?.CashCustomer == true ? "CASH" : refund;

    protected override async Task OnInitializedAsync()
    {
        await S.LoadAsync();
        if (!S.LoggedIn)
        {
            Nav.NavigateTo(S.Connection is null ? "database" : "login");
        }
    }

    private static string Qty(decimal v) => v.ToString("0.###", CultureInfo.InvariantCulture);

    private bool ToStock(ReturnableLine l) => toStock.GetValueOrDefault(l.SalesDetailID, true);

    private (string Problem, decimal Net, decimal Tax, decimal Total) Amount(ReturnableLine l) =>
        qty.TryGetValue(l.SalesDetailID, out var q) && q > 0 ? l.Amounts(q) : ("-", 0, 0, 0);

    private decimal Total => invoice?.Lines.Select(Amount).Where(a => a.Problem.Length == 0).Sum(a => a.Total) ?? 0;

    private async Task FocusNumberAsync()
    {
        if (numberField is not null)
        {
            await numberField.FocusAsync();
        }
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FindAsync();
        }
        else if (e.Key == "F9")
        {
            await SaveAsync();
        }
    }

    private async Task FindAsync()
    {
        busy = true;
        var (inv, text) = await S.FindForReturnAsync(number);
        Load(inv);
        Show(text, text.Length > 0);
        busy = false;
    }

    /// <summary>Another return: the number field cleared and the invoice put away (a page only; nothing is saved).</summary>
    private async Task NewAsync()
    {
        if (busy)
        {
            return;
        }
        number = "";
        message = "";
        Load(null);
        await FocusNumberAsync();
    }

    private void Load(ReturnableInvoice? inv)
    {
        invoice = inv;
        qty.Clear();
        toStock.Clear();
        reason = "";
        reference = PosSession.NewReference();
        refund = inv is { PaymentType: "CREDIT", CashCustomer: false } ? "CREDIT" : "CASH";
        method = SalesService.CashMethodId;
    }

    /// <summary>modPOS.ReturnLineChanged: not below zero, not above what is left.</summary>
    private void SetQty(ReturnableLine l, decimal q)
    {
        if (q < 0)
        {
            q = 0;
        }
        if (q > l.AvailableQty)
        {
            Show(L.T("الكمية المرتجعة أكبر من المتاح للإرجاع") + " (" + Qty(l.AvailableQty) + ").", true);
            q = l.AvailableQty;
        }
        qty[l.SalesDetailID] = q;
        reference = PosSession.NewReference();
    }

    private void ReturnAll()
    {
        foreach (var l in invoice!.Lines)
        {
            qty[l.SalesDetailID] = l.AvailableQty;
        }
        reference = PosSession.NewReference();
    }

    private void Show(string text, bool isError)
    {
        message = text;
        error = isError && text.Length > 0;
    }

    private async Task SaveAsync()
    {
        if (busy || invoice is null || Total <= 0)
        {
            return;
        }
        busy = true;
        var lines = invoice.Lines.Where(l => qty.GetValueOrDefault(l.SalesDetailID) > 0)
            .Select(l => new ReturnLineRequest(l.SalesDetailID, qty[l.SalesDetailID], ToStock(l))).ToArray();
        int? how = Refund == "CASH" ? method : null;
        var (status, text, doc) = await S.SaveReturnAsync(new DeviceReturnRequest(reference, invoice.SalesInvoiceID, reason, Refund, how, lines));
        if (status != SaveStatus.Saved || doc is null)
        {
            Show(text, true);
            busy = false;
            return;
        }
        last = doc;
        lastCash = Refund == "CASH" && how == SalesService.CashMethodId;
        string printed = await S.PrintDocumentAsync(doc, lastCash);
        Show(L.T("تم حفظ المرتجع") + " " + doc.Number + (printed.Length > 0 ? " · " + printed : ""), printed.Length > 0);
        var (inv, _) = await S.FindForReturnAsync(invoice.InvoiceNumber);
        Load(inv);
        busy = false;
    }

    private async Task ReprintAsync()
    {
        string printed = await S.PrintDocumentAsync(last!, lastCash, reprint: true);
        Show(printed, printed.Length > 0);
    }
}
