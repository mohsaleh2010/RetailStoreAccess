@page "/database"
@inject PosSession S
@inject UiLanguage L
@inject NavigationManager Nav

@* The database settings of the PC (template D): local (SQL Server of the store or a SQLite trial file) or a remote
   server through the API, and the device code. Only an administrator changes them, anyone on the first run
   (PosSession.CanEditDatabase); the same TestConnectionAsync / SaveConnectionAsync, F2 = save. *@
<PageHeader Title="@L.T("إعدادات قاعدة البيانات")" Icon="@Icons.Material.Outlined.Storage" />

@if (!S.CanEditDatabase)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@L.T("إعدادات قاعدة البيانات لمدير النظام فقط.")</MudAlert>
}
else
{
    <KeyboardShortcuts OnSave="SaveAsync" />
    <MudPaper Outlined="true" Class="pa-4 pos-card-form">
        @if (S.Connection is null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">@L.T("أول تشغيل على هذا الجهاز: اختر مكان بيانات البرنامج. بعد الحفظ لا يغيّرها إلا مدير النظام.")</MudAlert>
        }
        <MudRadioGroup T="string" @bind-Value="mode" Class="mb-3">
            <MudRadio T="string" Value="@PosConnection.Local" Color="Color.Primary" Size="Size.Large">@L.T("قاعدة بيانات محلية")</MudRadio>
            <MudRadio T="string" Value="@PosConnection.Remote" Color="Color.Primary" Size="Size.Large">@L.T("خادم بعيد")</MudRadio>
        </MudRadioGroup>

        <MudGrid Spacing="3">
            @if (mode == PosConnection.Local)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L.T("SQL Server على هذا الجهاز أو على شبكة المحل، وهو القاعدة نفسها التي يربط بها Access والموقع. يعمل البيع إن انقطع الإنترنت.")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="provider" Label="@L.T("النوع")" Variant="Variant.Outlined" Margin="Margin.Normal"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@PosConnection.SqlServer">SQL Server</MudSelectItem>
                        <MudSelectItem T="string" Value="@PosConnection.Sqlite">@L.T("ملف تجربة SQLite")</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (provider == PosConnection.Sqlite)
                {
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="sqliteFile" Label="@L.T("ملف قاعدة التجربة")" Variant="Variant.Outlined"
                                      Margin="Margin.Normal" Placeholder="C:\RetailStore\trial.db" UserAttributes="Ltr" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="server" Label="@L.T("اسم الخادم")" Variant="Variant.Outlined"
                                      Margin="Margin.Normal" Placeholder=".\SQLEXPRESS" UserAttributes="Ltr" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="database" Label="@L.T("قاعدة البيانات")" Variant="Variant.Outlined"
                                      Margin="Margin.Normal" UserAttributes="Ltr" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox T="bool" @bind-Value="windowsLogin" Color="Color.Primary" Label="@L.T("الدخول بحساب Windows")" />
                    </MudItem>
                    @if (!windowsLogin)
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="sqlUser" Label="@L.T("مستخدم SQL Server")" Variant="Variant.Outlined"
                                          Margin="Margin.Normal" UserAttributes="Ltr" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="password" Label="@L.T("كلمة المرور")" InputType="InputType.Password"
                                          Variant="Variant.Outlined" Margin="Margin.Normal"
                                          Placeholder="@(S.Connection is null ? "" : "••••")" UserAttributes="Ltr" />
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <MudCheckBox T="bool" @bind-Value="trust" Color="Color.Primary" Label="@L.T("الوثوق بشهادة خادم المحل")" />
                    </MudItem>
                }
            }
            else
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L.T("خادم البرنامج في مكان آخر، عبر الـ API بعنوانه وبـ HTTPS. إن انقطع الإنترنت يبيع الجهاز ويحفظ الفواتير، وتُرسل عند عودته.")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="url" Label="@L.T("عنوان الخادم")" Variant="Variant.Outlined"
                                  Margin="Margin.Normal" Placeholder="https://" UserAttributes="Ltr" />
                </MudItem>
            }
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="deviceCode" Label="@L.T("رمز الجهاز")" Variant="Variant.Outlined"
                              Margin="Margin.Normal" MaxLength="8" UserAttributes="Ltr"
                              HelperText="@L.T("يبدأ به رقم كل فاتورة من هذا الجهاز، مثل POS1-000001. اجعل لكل جهاز رمزًا مختلفًا.")" />
            </MudItem>
            @if (message.Length > 0)
            {
                <MudItem xs="12">
                    <MudAlert Severity="@(ok ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Class="pos-pre"
                              role="@(ok ? "status" : "alert")">@L.T(message)</MudAlert>
                </MudItem>
            }
            <MudItem xs="12">
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Outlined.Save"
                               Disabled="@busy" OnClick="SaveAsync">@L.T("حفظ") <kbd class="erp-kbd">F2</kbd></MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Outlined.NetworkCheck" Disabled="@busy" OnClick="TestAsync">@L.T("اختبار الاتصال")</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
        @if (busy)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
        }
    </MudPaper>
}

@code {
    private string mode = PosConnection.Local, provider = PosConnection.SqlServer, server = "", database = "", sqlUser = "",
                   password = "", sqliteFile = "", url = "", deviceCode = "", message = "";
    private bool windowsLogin = true, trust = true, busy, ok;

    /// <summary>Addresses, names and codes are typed left to right in both languages.</summary>
    private static readonly Dictionary<string, object?> Ltr = new() { ["dir"] = "ltr" };

    protected override async Task OnInitializedAsync()
    {
        await S.LoadAsync();
        var c = S.Connection ?? PosConnection.Empty;
        (mode, provider, server, database, windowsLogin, sqlUser, trust, sqliteFile, url, deviceCode) =
            (c.Mode, c.Provider, c.Server, c.Database, c.WindowsLogin, c.User, c.TrustCertificate, c.SqliteFile, c.ServerUrl, c.DeviceCode);
    }

    private PosConnection Current() => new(mode, provider, server, database, windowsLogin, sqlUser, trust, sqliteFile, url, deviceCode);

    /// <summary>The password typed, else the one kept when the same SQL login is saved again.</summary>
    private async Task<string?> PasswordAsync() =>
        password.Length > 0 ? password : await S.Platform.GetSecretAsync(PosSession.PasswordKey);

    private async Task TestAsync()
    {
        busy = true;
        message = await S.TestConnectionAsync(Current(), await PasswordAsync());
        ok = message.Length == 0;
        if (ok)
        {
            message = L.T("الاتصال ناجح.");
        }
        busy = false;
    }

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }
        busy = true;
        bool first = S.Connection is null;
        message = await S.SaveConnectionAsync(Current(), await PasswordAsync());
        ok = message.Length == 0;
        busy = false;
        if (ok)
        {
            password = "";
            message = L.T("تم الحفظ");
            if (first || !S.LoggedIn)
            {
                Nav.NavigateTo("login");
            }
        }
    }
}
