<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The point of sale on Windows (docs/83): its screens, its offline logic and its two ways to the data, shared by the
       Windows program (RetailStore.Pos) and the tests. A local database (SQL Server of the store, or a SQLite trial file)
       is used directly through RetailStore.Data; a remote one only through the API (/api/v1/pos). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetailStore.Data\RetailStore.Data.csproj" />
  </ItemGroup>

</Project>
