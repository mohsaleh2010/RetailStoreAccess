@page "/password"
@inject RepSession S
@inject NavigationManager Nav

<section class="rep-card rep-login">
    <h1>@S.T("تغيير كلمة المرور")</h1>
    @if (S.MustChangePassword)
    {
        <p>@S.T("يجب تغيير كلمة المرور قبل المتابعة")</p>
    }
    <label>@S.T("كلمة المرور الحالية")<input dir="ltr" type="password" @bind="oldPassword" /></label>
    <label>@S.T("كلمة المرور الجديدة")<input dir="ltr" type="password" @bind="newPassword" /></label>
    <label>@S.T("تأكيد كلمة المرور")<input dir="ltr" type="password" @bind="confirm" /></label>
    @if (message.Length > 0)
    {
        <p class="rep-error">@message</p>
    }
    <button class="rep-primary" disabled="@busy" @onclick="SaveAsync">@S.T("حفظ")</button>
</section>

@code {
    private string oldPassword = "", newPassword = "", confirm = "", message = "";
    private bool busy;

    private async Task SaveAsync()
    {
        busy = true;
        message = await S.ChangePasswordAsync(oldPassword, newPassword, confirm);
        busy = false;
        if (message.Length == 0)
        {
            await S.SyncAsync();
            Nav.NavigateTo("");
        }
    }
}
