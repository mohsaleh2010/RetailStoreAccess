<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The rep app (docs/78): its screens and its offline logic, shared by the Android app (RetailStore.App) and the tests.
       It never reaches the database: everything goes through the API (/api/v1/rep) and a SQLite file on the phone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetailStore.Domain\RetailStore.Domain.csproj" />
  </ItemGroup>

</Project>
