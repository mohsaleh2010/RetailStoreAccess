@* The router of the rep app (docs/78): the Android app (RetailStore.App) shows it in its BlazorWebView. *@
<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(RepLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(RepLayout)">
            <p class="rep-empty">@S.T("الصفحة غير موجودة")</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    [Inject] private RepSession S { get; set; } = default!;
}
